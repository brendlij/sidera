<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The design tokens of Astra: every colour, size, spacing and shape that a view uses comes from here.
        Views never carry a hex colour, a font size or a margin of their own; they pick a token or a style class.
    -->
    <Styles.Resources>

        <!-- Surfaces, from the darkest to the lightest: window and sidebar, workspace, panel, raised (inputs, hover) -->
        <Color x:Key="AstraBg0Color">#0E0F13</Color>
        <Color x:Key="AstraBg1Color">#15161B</Color>
        <Color x:Key="AstraBg2Color">#1C1D24</Color>
        <Color x:Key="AstraBg3Color">#252630</Color>
        <Color x:Key="AstraBg4Color">#2E3039</Color>
        <Color x:Key="AstraLineColor">#262830</Color>
        <Color x:Key="AstraLineStrongColor">#363842</Color>

        <!-- One accent, violet-blue -->
        <Color x:Key="AstraAccentColor">#7F83EC</Color>
        <Color x:Key="AstraAccentHoverColor">#9498F2</Color>
        <Color x:Key="AstraAccentPressedColor">#6E72DA</Color>
        <Color x:Key="AstraAccentTintColor">#247F83EC</Color>
        <Color x:Key="AstraAccentTintStrongColor">#387F83EC</Color>

        <Color x:Key="AstraOkColor">#6FCB9F</Color>
        <Color x:Key="AstraWarnColor">#E3B25E</Color>
        <Color x:Key="AstraDangerColor">#E57F7F</Color>

        <SolidColorBrush x:Key="AstraBg0" Color="{StaticResource AstraBg0Color}" />
        <SolidColorBrush x:Key="AstraBg1" Color="{StaticResource AstraBg1Color}" />
        <SolidColorBrush x:Key="AstraBg2" Color="{StaticResource AstraBg2Color}" />
        <SolidColorBrush x:Key="AstraBg3" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="AstraBg4" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="AstraLine" Color="{StaticResource AstraLineColor}" />
        <SolidColorBrush x:Key="AstraLineStrong" Color="{StaticResource AstraLineStrongColor}" />
        <SolidColorBrush x:Key="AstraPreview" Color="#0A0B0E" />
        <SolidColorBrush x:Key="AstraScrim" Color="#B30A0B0E" />

        <SolidColorBrush x:Key="AstraText" Color="#EDEBE7" />
        <SolidColorBrush x:Key="AstraTextSecondary" Color="#B6B8C2" />
        <SolidColorBrush x:Key="AstraMuted" Color="#7F8190" />
        <SolidColorBrush x:Key="AstraOnAccent" Color="#101116" />

        <SolidColorBrush x:Key="AstraAccent" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="AstraAccentHover" Color="{StaticResource AstraAccentHoverColor}" />
        <SolidColorBrush x:Key="AstraAccentPressed" Color="{StaticResource AstraAccentPressedColor}" />
        <SolidColorBrush x:Key="AstraAccentTint" Color="{StaticResource AstraAccentTintColor}" />
        <SolidColorBrush x:Key="AstraAccentTintStrong" Color="{StaticResource AstraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="AstraOk" Color="{StaticResource AstraOkColor}" />
        <SolidColorBrush x:Key="AstraWarn" Color="{StaticResource AstraWarnColor}" />
        <SolidColorBrush x:Key="AstraDanger" Color="{StaticResource AstraDangerColor}" />
        <SolidColorBrush x:Key="AstraDangerTint" Color="#26E57F7F" />

        <!-- Spacing: 4 8 12 16 24 32, as numbers (for Spacing) and as thickness (for Margin and Padding) -->
        <x:Double x:Key="Space1">4</x:Double>
        <x:Double x:Key="Space2">8</x:Double>
        <x:Double x:Key="Space3">12</x:Double>
        <x:Double x:Key="Space4">16</x:Double>
        <x:Double x:Key="Space5">24</x:Double>
        <x:Double x:Key="Space6">32</x:Double>
        <Thickness x:Key="Inset1">4</Thickness>
        <Thickness x:Key="Inset2">8</Thickness>
        <Thickness x:Key="Inset3">12</Thickness>
        <Thickness x:Key="Inset4">16</Thickness>
        <Thickness x:Key="Inset5">24</Thickness>
        <Thickness x:Key="Inset6">32</Thickness>
        <Thickness x:Key="InsetRow">12,8</Thickness>
        <Thickness x:Key="InsetPanel">16</Thickness>
        <Thickness x:Key="InsetPage">32,24</Thickness>

        <!-- Shape -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusLg">10</CornerRadius>

        <!-- Type scale -->
        <x:Double x:Key="FontPageTitle">24</x:Double>
        <x:Double x:Key="FontSection">17</x:Double>
        <x:Double x:Key="FontCardTitle">14</x:Double>
        <x:Double x:Key="FontValue">14</x:Double>
        <x:Double x:Key="FontBody">13</x:Double>
        <x:Double x:Key="FontSecondary">12</x:Double>
        <x:Double x:Key="FontMeta">11</x:Double>
        <x:Double x:Key="FontValueLarge">20</x:Double>
        <x:Double x:Key="FontWordmark">17</x:Double>

        <!-- Icons: 24 x 24 outlines, drawn with the foreground of the control that shows them -->
        <StreamGeometry x:Key="IconDashboard">M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z</StreamGeometry>
        <StreamGeometry x:Key="IconSession">M3 10h11v2H3zm0-4h11v2H3zm0 8h7v2H3zm13-1v8l6-4z</StreamGeometry>
        <StreamGeometry x:Key="IconImaging">M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z</StreamGeometry>
        <StreamGeometry x:Key="IconEquipment">M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z</StreamGeometry>
        <StreamGeometry x:Key="IconDiagnostics">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconDrag">M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconMore">M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconCamera">M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="IconRig">M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z</StreamGeometry>
        <StreamGeometry x:Key="IconTarget">M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3c-.46-4.17-3.77-7.48-7.94-7.94V1h-2v2.06C6.83 3.52 3.52 6.83 3.06 11H1v2h2.06c.46 4.17 3.77 7.48 7.94 7.94V23h2v-2.06c4.17-.46 7.48-3.77 7.94-7.94H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>

        <!--
            What the Fluent theme draws its controls with, set to the palette above, so that text boxes, drop-downs, check
            boxes and progress bars follow Astra's surfaces and its one accent without a template of our own.
        -->
        <Color x:Key="SystemAccentColor">#7F83EC</Color>
        <Color x:Key="SystemAccentColorLight1">#9498F2</Color>
        <Color x:Key="SystemAccentColorLight2">#A9ACF6</Color>
        <Color x:Key="SystemAccentColorDark1">#6E72DA</Color>
        <Color x:Key="SystemAccentColorDark2">#5F63C4</Color>

        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource AstraBg2Color}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#EDEBE7" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#EDEBE7" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDEBE7" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7F8190" />
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource AstraBg2Color}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource AstraLineStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AstraAccentTintColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AstraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource AstraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#EDEBE7" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#EDEBE7" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#EDEBE7" />

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource AstraLineStrongColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#7F8190" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AstraAccentHoverColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AstraAccentPressedColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AstraAccentHoverColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AstraAccentPressedColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#101116" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#101116" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#101116" />

        <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource AstraLineStrongColor}" />

        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource AstraBg3Color}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource AstraLineStrongColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource AstraBg4Color}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource AstraBg4Color}" />
    </Styles.Resources>
</Styles>
