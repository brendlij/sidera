<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The type scale. A TextBlock picks one class and nothing else: no view sets a size or a weight by itself.
        page-title  22-24, once per page
        section-title  16-18, a major part of a page
        card-title  13-15 semibold, the name of a card or an item
        value  the number or name a card is about
        (none)  body text, 13
        secondary  12, supporting text
        meta  11, muted, identifiers and units
        eyebrow  11, muted, spaced capitals that name a group
    -->

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{StaticResource FontPageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="{StaticResource FontCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="{StaticResource FontValue}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.value-large">
        <Setter Property="FontSize" Value="{StaticResource FontValueLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="{StaticResource FontMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="{StaticResource FontMeta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
    </Style>
    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="{StaticResource FontWordmark}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="5" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>

    <!-- Meaning, on top of any size -->
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource AstraAccent}" />
    </Style>
    <Style Selector="TextBlock.ok">
        <Setter Property="Foreground" Value="{DynamicResource AstraOk}" />
    </Style>
    <Style Selector="TextBlock.warn">
        <Setter Property="Foreground" Value="{DynamicResource AstraWarn}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource AstraDanger}" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The names the first version of the theme used; they now mean the nearest step of the new scale -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{StaticResource FontMeta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
    </Style>
    <Style Selector="TextBlock.current">
        <Setter Property="FontSize" Value="{StaticResource FontValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.container">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
