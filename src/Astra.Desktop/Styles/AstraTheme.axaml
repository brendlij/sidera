<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Astra theme, on top of the Fluent controls. Order matters: the tokens first (and with them the resources the
        Fluent controls read), then the type scale, the surfaces, the controls and finally Astra's own controls.
    -->
    <StyleInclude Source="avares://Astra.Desktop/Styles/Tokens.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/Typography.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/Surfaces.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/Inputs.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/Lists.axaml" />
    <StyleInclude Source="avares://Astra.Desktop/Styles/CustomControls.axaml" />
</Styles>
