<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Palette: charcoal surfaces, off-white text, one violet-blue accent. -->
        <Color x:Key="AstraBackgroundColor">#17181C</Color>
        <Color x:Key="AstraSurfaceColor">#212227</Color>
        <Color x:Key="AstraRaisedColor">#2B2D34</Color>
        <Color x:Key="AstraHoverColor">#363842</Color>
        <Color x:Key="AstraAccentColor">#7B7FE8</Color>
        <Color x:Key="AstraAccentHoverColor">#8F93F0</Color>

        <SolidColorBrush x:Key="AstraBackground" Color="{StaticResource AstraBackgroundColor}" />
        <SolidColorBrush x:Key="AstraSurface" Color="{StaticResource AstraSurfaceColor}" />
        <SolidColorBrush x:Key="AstraRaised" Color="{StaticResource AstraRaisedColor}" />
        <SolidColorBrush x:Key="AstraHover" Color="{StaticResource AstraHoverColor}" />
        <SolidColorBrush x:Key="AstraPreview" Color="#0F1013" />
        <SolidColorBrush x:Key="AstraText" Color="#ECEAE6" />
        <SolidColorBrush x:Key="AstraMuted" Color="#9A9CA8" />
        <SolidColorBrush x:Key="AstraAccent" Color="{StaticResource AstraAccentColor}" />
        <SolidColorBrush x:Key="AstraAccentHover" Color="{StaticResource AstraAccentHoverColor}" />
        <SolidColorBrush x:Key="AstraOk" Color="#7CC9A4" />
        <SolidColorBrush x:Key="AstraWarn" Color="#E0B060" />
        <SolidColorBrush x:Key="AstraDanger" Color="#E27B7B" />
    </Styles.Resources>

    <!-- Text -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource AstraDanger}" />
    </Style>
    <Style Selector="TextBlock.nav">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{DynamicResource AstraMuted}" />
    </Style>
    <Style Selector="TextBlock.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="TextBlock.nav.disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource AstraSurface}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AstraSurface}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource AstraRaised}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.preview">
        <Setter Property="Background" Value="{DynamicResource AstraPreview}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.navMarker">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource AstraAccent}" />
    </Style>

    <!-- Status badges: neutral by default, tinted through .ok / .running / .warn / .danger -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AstraRaised}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge Ellipse.dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource AstraMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.badge.ok Ellipse.dot">
        <Setter Property="Fill" Value="{DynamicResource AstraOk}" />
    </Style>
    <Style Selector="Border.badge.running Ellipse.dot">
        <Setter Property="Fill" Value="{DynamicResource AstraAccent}" />
    </Style>
    <Style Selector="Border.badge.warn Ellipse.dot">
        <Setter Property="Fill" Value="{DynamicResource AstraWarn}" />
    </Style>
    <Style Selector="Border.badge.danger Ellipse.dot">
        <Setter Property="Fill" Value="{DynamicResource AstraDanger}" />
    </Style>

    <!-- Buttons: flat, no border; .accent is the primary action -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AstraRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AstraHover}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AstraRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraText}" />
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AstraAccent}" />
        <Setter Property="Foreground" Value="#14151A" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AstraAccentHover}" />
        <Setter Property="Foreground" Value="#14151A" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AstraAccent}" />
        <Setter Property="Foreground" Value="#14151A" />
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Progress -->
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource AstraRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource AstraAccent}" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="3" />
    </Style>
</Styles>
