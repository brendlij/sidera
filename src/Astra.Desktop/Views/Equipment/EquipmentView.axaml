<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             x:Class="Astra.Desktop.Views.Equipment.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <!--
        The equipment workspace. It has a context bar (the devices operated directly, and each rig when there are any), under it
        the pages of the selected context, and under that the page: the overview of everything, the overview of a rig, or the page
        of one kind of device, which uses the whole width. A way back is always shown. Adding and editing a device is a form
        that opens over the page.
    -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="{StaticResource InsetPage}" RowSpacing="16">

            <ctl:PageHeader Title="Equipment">
                <Button Classes="secondary" Command="{Binding AddDeviceCommand}" IsVisible="{Binding CanManage}" AutomationProperties.Name="Add device">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconAdd}" />
                        <TextBlock Text="Add device" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ctl:PageHeader>

            <equipment:EquipmentBreadcrumbView Grid.Row="1" IsVisible="{Binding IsContextShown}" />

            <StackPanel Grid.Row="2" Spacing="8">
                <Border Classes="notice-danger" IsVisible="{Binding HasProblems}">
                    <TextBlock Classes="danger" Text="{Binding ProblemsText}" TextWrapping="Wrap" />
                </Border>
                <Border Classes="notice-danger" IsVisible="{Binding HasNotice}">
                    <TextBlock Classes="danger" Text="{Binding NoticeText}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- The contexts: Standalone, and one tab for each rig -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Contexts}" IsVisible="{Binding HasDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EquipmentContextViewModel">
                        <RadioButton Classes="segment" GroupName="EquipmentContext" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The pages of the selected context -->
            <StackPanel Grid.Row="4" Spacing="0" IsVisible="{Binding IsContextShown}">
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EquipmentPageViewModel">
                            <RadioButton Classes="tab" GroupName="EquipmentPage" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="divider" />
            </StackPanel>

            <Panel Grid.Row="5">
                <equipment:EquipmentLandingView IsVisible="{Binding IsLanding}" />

                <ContentControl Content="{Binding SelectedRig}" IsVisible="{Binding IsRigOverview}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:RigViewModel">
                            <equipment:RigOverviewView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <equipment:DeviceWorkspaceView IsVisible="{Binding IsDeviceWorkspace}" />

                <ctl:EmptyState Icon="{StaticResource IconEquipment}" Title="Nothing here yet" IsVisible="{Binding IsContextEmpty}"
                                Message="This context has no device. Devices appear here when they are added to Astra." />
            </Panel>
        </Grid>

        <!-- The form for adding or editing a device, over the page: the page behind it waits -->
        <Grid IsVisible="{Binding IsEditorOpen}">
            <Border Background="{DynamicResource AstraScrim}" />
            <ContentControl Content="{Binding Editor}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource InsetPage}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:DeviceEditorViewModel">
                        <equipment:DeviceEditorView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Panel>
</UserControl>
