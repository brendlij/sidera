<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:workspaces="using:Astra.Desktop.Views.Equipment.Workspaces"
             x:Class="Astra.Desktop.Views.Equipment.Workspaces.FocuserWorkspaceView"
             x:DataType="vm:FocuserDetailViewModel">

    <!--
        The focuser: where it is and where it can go, a move, and temperature and its compensation where the focuser has them. A
        relative focuser has no position and no range: it is shown as one and moved by steps.
    -->
    <StackPanel Spacing="8">
        <WrapPanel>
            <ctl:WorkspaceSection Header="POSITION">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <ctl:InfoRow Label="Position" Value="{Binding Focuser.PositionText}" />
                        <ctl:InfoRow Label="Range" Value="{Binding Focuser.RangeText}" />
                        <ctl:InfoRow Label="Motion" Value="{Binding Focuser.MotionText}" IsVisible="{Binding Focuser.IsConnected}" />
                        <ctl:InfoRow Label="Part of" Value="{Binding RigText}" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Focuser.PositionFraction}" IsVisible="{Binding Focuser.IsAbsolute}" />
                </StackPanel>
            </ctl:WorkspaceSection>

            <ctl:WorkspaceSection Header="MOVE TO POSITION" IsVisible="{Binding Focuser.IsAbsolute}">
                <StackPanel Spacing="16">
                    <ctl:FieldRow Label="Target position" Unit="steps"><TextBox Text="{Binding Focuser.TargetInput}" /></ctl:FieldRow>
                    <Button Classes="primary" Content="Move" Command="{Binding Focuser.MoveCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:WorkspaceSection>

            <ctl:WorkspaceSection Header="MOVE BY STEPS" IsVisible="{Binding Control.IsAvailable}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding Control.IsRelative}"
                               Text="This focuser is relative: it has no position, so it cannot move to a target and autofocus cannot use it." />
                    <ctl:FieldRow Label="Steps" Unit="{Binding Control.StepsHint}"><TextBox Text="{Binding Control.StepsText}" /></ctl:FieldRow>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Move in" Command="{Binding Control.MoveByCommand}" CommandParameter="-" />
                        <Button Content="Move out" Command="{Binding Control.MoveByCommand}" CommandParameter="+" />
                    </StackPanel>
                </StackPanel>
            </ctl:WorkspaceSection>

            <ctl:WorkspaceSection Header="TEMPERATURE" IsVisible="{Binding Control.ShowTemperature}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="page-title" Text="{Binding Control.TemperatureText}" />
                </StackPanel>
            </ctl:WorkspaceSection>

            <ctl:WorkspaceSection Header="TEMPERATURE COMPENSATION" IsVisible="{Binding Control.ShowTempComp}">
                <StackPanel Spacing="16">
                    <CheckBox Content="Compensate for temperature" IsChecked="{Binding Control.TempComp}" />
                    <Button Classes="primary" Content="Apply" Command="{Binding Control.ApplyTempCompCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:WorkspaceSection>
        </WrapPanel>

    </StackPanel>
</UserControl>
