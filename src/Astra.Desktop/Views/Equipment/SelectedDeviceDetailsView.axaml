<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             x:Class="Astra.Desktop.Views.Equipment.SelectedDeviceDetailsView"
             x:DataType="vm:EquipmentViewModel">

    <!-- The detail of the selected device: the view of its kind, replaced as the selection changes -->
    <ContentControl Content="{Binding SelectedDetail}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
            <equipment:DeviceDetailsTemplate />
        </ContentControl.ContentTemplate>
    </ContentControl>
</UserControl>
