<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             x:Class="Astra.Desktop.Views.Equipment.RigDetailsView"
             x:DataType="vm:RigViewModel">

    <!-- A rig, read-only: its devices and their state (each opens on its own, in the Devices mode), its optics, and its state -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="RIG" />
                    <TextBlock Classes="page-title" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="meta" Text="{Binding RigIdText}" />
                        <TextBlock Classes="meta" Text="{Binding OpticsShortText}" />
                    </StackPanel>
                </StackPanel>
                <ctl:StatusIndicator Grid.Column="1" Kind="{Binding StatusKind}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="DEVICES" />
                <Border Classes="panel">
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RigMemberViewModel">
                                <Grid ColumnDefinitions="120,*,Auto,Auto" ColumnSpacing="16" MinHeight="40">
                                    <TextBlock Classes="secondary" Text="{Binding Role}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="value" Text="{Binding NameText}" Classes.meta="{Binding !IsConfigured}" />
                                        <TextBlock Classes="meta" Text="{Binding Device.ActivityText}" IsVisible="{Binding IsConfigured}" />
                                    </StackPanel>
                                    <ctl:StatusIndicator Grid.Column="2" Kind="{Binding Device.StatusKind}" Text="{Binding Device.StatusText}"
                                                         IsVisible="{Binding IsConfigured}" />
                                    <Button Grid.Column="3" Classes="ghost" Content="Open" Command="{Binding Device.OpenCommand}"
                                            AutomationProperties.Name="{Binding NameText, StringFormat=Open {0}}"
                                            IsVisible="{Binding IsConfigured}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="OPTICS" />
                    <Border Classes="panel">
                        <StackPanel Spacing="2">
                            <ctl:InfoRow Label="Focal length" Value="{Binding FocalLengthText}" />
                            <ctl:InfoRow Label="Aperture" Value="{Binding ApertureText}" />
                            <ctl:InfoRow Label="Pixel size" Value="{Binding PixelSizeText}" />
                            <ctl:InfoRow Label="Sensor" Value="{Binding SensorText}" />
                            <ctl:InfoRow Label="Resolution" Value="{Binding ResolutionText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Classes="eyebrow" Text="STATE" />
                    <Border Classes="panel">
                        <StackPanel Spacing="2">
                            <ctl:InfoRow Label="Camera" Value="{Binding ActivityText}" />
                            <ctl:InfoRow Label="Focus" Value="{Binding FocusText}" IsVisible="{Binding HasFocuser}" />
                            <ctl:InfoRow Label="Filter" Value="{Binding FilterText}" IsVisible="{Binding HasFilterWheel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="CONFIGURATION" />
                <Border Classes="panel">
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="Rigs are described when Astra starts and cannot be edited here yet. Rig configuration will live on this page." />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
