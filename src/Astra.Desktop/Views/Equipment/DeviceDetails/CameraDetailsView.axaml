<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             x:Class="Astra.Desktop.Views.Equipment.DeviceDetails.CameraDetailsView"
             x:DataType="vm:CameraDetailViewModel">

    <!-- A camera: what it is doing and what is known about its sensor, the manual exposure, and where the frame goes -->
    <equipment:DeviceDetailShell>
        <equipment:DeviceDetailShell.OverviewContent>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="STATUS" />
                    <Border Classes="panel">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <ctl:InfoRow Label="Exposure" Value="{Binding Camera.ActivityText}" IsVisible="{Binding Camera.IsConnected}" />
                                <ctl:InfoRow Label="Exposure" Value="Not connected" IsVisible="{Binding Camera.IsDisconnected}" />
                                <ctl:InfoRow Label="Part of" Value="{Binding RigText}" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Camera.ExposureProgress}" IsVisible="{Binding Camera.IsExposing}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Classes="eyebrow" Text="SENSOR" />
                    <Border Classes="panel">
                        <StackPanel Spacing="2">
                            <ctl:InfoRow Label="Resolution" Value="{Binding ResolutionText}" />
                            <ctl:InfoRow Label="Pixel size" Value="{Binding PixelSizeText}" />
                            <ctl:InfoRow Label="Sensor size" Value="{Binding SensorText}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="12" IsVisible="{Binding Settings.ShowCcdTemperature}">
                        <TextBlock Classes="eyebrow" Text="TEMPERATURE" />
                        <Border Classes="panel">
                            <StackPanel Spacing="2">
                                <ctl:InfoRow Label="Sensor" Value="{Binding Settings.CcdTemperatureText}" />
                                <ctl:InfoRow Label="Cooler power" Value="{Binding Settings.CoolerPowerText}" IsVisible="{Binding Settings.ShowCoolerPower}" />
                                <ctl:InfoRow Label="Heat sink" Value="{Binding Settings.HeatSinkText}" IsVisible="{Binding Settings.ShowHeatSink}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </equipment:DeviceDetailShell.OverviewContent>

        <equipment:DeviceDetailShell.ControlsContent>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="MANUAL EXPOSURE" />
                    <Border Classes="panel">
                        <StackPanel Spacing="16">
                            <ctl:FieldRow Label="Exposure time" Unit="s"><TextBox Text="{Binding Camera.ExposureInput}" /></ctl:FieldRow>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="Start Exposure" Command="{Binding Camera.StartExposureCommand}" />
                                <Button Classes="danger" Content="Cancel Exposure" Command="{Binding Camera.CancelExposureCommand}"
                                        IsVisible="{Binding Camera.IsManualExposureRunning}" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Camera.ExposureProgress}" IsVisible="{Binding Camera.IsExposing}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Classes="eyebrow" Text="PREVIEW" />
                    <Border Classes="panel">
                        <ctl:InfoRow Label="Last frame" Value="{Binding Camera.LastFrameText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </equipment:DeviceDetailShell.ControlsContent>

        <equipment:DeviceDetailShell.SettingsContent>
            <ContentControl Content="{Binding Settings}" IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:CameraSettingsViewModel">
                        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Classes="eyebrow" Text="ACQUISITION DEFAULTS" />
                            <Border Classes="panel" IsVisible="{Binding IsUnavailable}">
                                <TextBlock Classes="secondary" TextWrapping="Wrap"
                                           Text="Connect the camera to see which settings it supports. Only those are shown here." />
                            </Border>
                            <Border Classes="panel" IsVisible="{Binding HasNoSettings}">
                                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="This camera reports no settings that can be changed." />
                            </Border>
                            <Border Classes="panel" IsVisible="{Binding HasSettings}">
                                <StackPanel Spacing="16">
                                    <ctl:FieldRow Label="Gain" Unit="{Binding Gain.Hint}" IsVisible="{Binding Gain.IsRange}"><TextBox Text="{Binding Gain.Text}" /></ctl:FieldRow>
                                    <ctl:LabeledField Label="Gain" IsVisible="{Binding Gain.IsList}">
                                        <ComboBox ItemsSource="{Binding Gain.Choices}" SelectedIndex="{Binding Gain.SelectedIndex}" HorizontalAlignment="Stretch" />
                                    </ctl:LabeledField>
                                    <ctl:FieldRow Label="Offset" Unit="{Binding Offset.Hint}" IsVisible="{Binding Offset.IsRange}"><TextBox Text="{Binding Offset.Text}" /></ctl:FieldRow>
                                    <ctl:LabeledField Label="Offset" IsVisible="{Binding Offset.IsList}">
                                        <ComboBox ItemsSource="{Binding Offset.Choices}" SelectedIndex="{Binding Offset.SelectedIndex}" HorizontalAlignment="Stretch" />
                                    </ctl:LabeledField>
                                    <ctl:FieldRow Label="Binning" IsVisible="{Binding ShowBinning}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox ItemsSource="{Binding BinChoices}" SelectedItem="{Binding SelectedBinX}" />
                                            <TextBlock Classes="secondary" Text="x" VerticalAlignment="Center" IsVisible="{Binding ShowAsymmetricBinning}" />
                                            <ComboBox ItemsSource="{Binding BinChoices}" SelectedItem="{Binding SelectedBinY}" IsVisible="{Binding ShowAsymmetricBinning}" />
                                        </StackPanel>
                                    </ctl:FieldRow>
                                    <ctl:LabeledField Label="Readout mode" IsVisible="{Binding ShowReadout}">
                                        <ComboBox ItemsSource="{Binding ReadoutChoices}" SelectedIndex="{Binding SelectedReadout}" HorizontalAlignment="Stretch" />
                                    </ctl:LabeledField>
                                    <CheckBox Content="Fast readout" IsChecked="{Binding FastReadout}" IsVisible="{Binding ShowFastReadout}" />
                                    <StackPanel Spacing="8" IsVisible="{Binding ShowSubframe}">
                                        <TextBlock Classes="eyebrow" Text="REGION" />
                                        <ctl:FieldRow Label="Start X" Unit="px"><TextBox Text="{Binding StartXText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Start Y" Unit="px"><TextBox Text="{Binding StartYText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Width" Unit="px"><TextBox Text="{Binding WidthText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Height" Unit="px"><TextBox Text="{Binding HeightText}" /></ctl:FieldRow>
                                        <TextBlock Classes="secondary" Text="{Binding SubframeHint}" TextWrapping="Wrap" />
                                        <Button Content="Full frame" Command="{Binding FullFrameCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Spacing="8" IsVisible="{Binding ShowCooling}">
                                        <TextBlock Classes="eyebrow" Text="COOLING" />
                                        <ctl:FieldRow Label="Target temperature" Unit="°C" IsVisible="{Binding ShowTargetTemperature}"><TextBox Text="{Binding TargetTemperatureText}" /></ctl:FieldRow>
                                        <CheckBox Content="Cooler on" IsChecked="{Binding CoolerOn}" IsVisible="{Binding ShowCooler}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" />
                                        <Button Content="Discard" Command="{Binding DiscardCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </equipment:DeviceDetailShell.SettingsContent>
    </equipment:DeviceDetailShell>
</UserControl>
