<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             x:Class="Astra.Desktop.Views.Equipment.DeviceDetails.MountDetailsView"
             x:DataType="vm:MountDetailViewModel">

    <!-- A mount: where it points and what it is doing, and a slew to coordinates -->
    <equipment:DeviceDetailShell>
        <equipment:DeviceDetailShell.OverviewContent>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="STATUS" />
                    <Border Classes="panel">
                        <StackPanel Spacing="2">
                            <ctl:InfoRow Label="Motion" Value="{Binding Mount.ActivityText}" IsVisible="{Binding Mount.IsConnected}" />
                            <ctl:InfoRow Label="Motion" Value="Not connected" IsVisible="{Binding Mount.IsDisconnected}" />
                            <ctl:InfoRow Label="Coordinates" Value="{Binding Mount.CoordinatesText}" />
                            <ctl:InfoRow Label="Used by" Value="The whole session" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12" IsVisible="{Binding Control.IsAvailable}">
                    <TextBlock Classes="eyebrow" Text="TELEMETRY" />
                    <Border Classes="panel">
                        <ItemsControl ItemsSource="{Binding Control.TelemetryLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InfoLine">
                                    <ctl:InfoRow Label="{Binding Label}" Value="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </equipment:DeviceDetailShell.OverviewContent>

        <equipment:DeviceDetailShell.ControlsContent>
          <StackPanel Spacing="24" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="SLEW" />
                <Border Classes="panel">
                    <StackPanel Spacing="16">
                        <ctl:FieldRow Label="Right ascension" Unit="h"><TextBox Text="{Binding Mount.RightAscensionInput}" /></ctl:FieldRow>
                        <ctl:FieldRow Label="Declination" Unit="°"><TextBox Text="{Binding Mount.DeclinationInput}" /></ctl:FieldRow>
                        <Button Classes="primary" Content="Slew" Command="{Binding Mount.SlewCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Content="{Binding Control}" IsVisible="{Binding Control, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:MountControlViewModel">
                        <StackPanel Spacing="12">
                            <Border Classes="panel" IsVisible="{Binding HasNoControls}">
                                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="This mount reports no controls beyond the slew." />
                            </Border>
                            <StackPanel Spacing="12" IsVisible="{Binding HasControls}">
                                <TextBlock Classes="eyebrow" Text="TRACKING AND PARK" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding TrackingButtonText}" Command="{Binding ToggleTrackingCommand}" IsVisible="{Binding ShowTracking}" />
                                            <Button Content="Park" Command="{Binding ParkCommand}" IsVisible="{Binding ShowPark}" />
                                            <Button Content="Unpark" Command="{Binding UnparkCommand}" IsVisible="{Binding ShowUnpark}" />
                                            <Button Content="Set park position" Command="{Binding SetParkCommand}" IsVisible="{Binding ShowSetPark}" />
                                            <Button Content="Find home" Command="{Binding FindHomeCommand}" IsVisible="{Binding ShowHome}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowTrackingRates}">
                                            <ComboBox ItemsSource="{Binding TrackingRateChoices}" SelectedItem="{Binding SelectedTrackingRate}" />
                                            <Button Content="Set tracking rate" Command="{Binding ApplyTrackingRateCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowAltAz}">
                                <TextBlock Classes="eyebrow" Text="SLEW TO ALTITUDE / AZIMUTH" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <ctl:FieldRow Label="Altitude" Unit="°"><TextBox Text="{Binding AltitudeText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Azimuth" Unit="°"><TextBox Text="{Binding AzimuthText}" /></ctl:FieldRow>
                                        <Button Classes="primary" Content="Slew" Command="{Binding SlewAltAzCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowSync}">
                                <TextBlock Classes="eyebrow" Text="SYNC" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <ctl:FieldRow Label="Right ascension" Unit="h"><TextBox Text="{Binding SyncRaText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Declination" Unit="°"><TextBox Text="{Binding SyncDecText}" /></ctl:FieldRow>
                                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                                   Text="Tells the mount where it points now. It changes what the mount believes, not where it points." />
                                        <Button Content="Sync" Command="{Binding SyncCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowPulseGuide}">
                                <TextBlock Classes="eyebrow" Text="PULSE GUIDE" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <ctl:FieldRow Label="Length" Unit="ms"><TextBox Text="{Binding PulseMillisecondsText}" /></ctl:FieldRow>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="North" Command="{Binding PulseCommand}" CommandParameter="North" />
                                            <Button Content="South" Command="{Binding PulseCommand}" CommandParameter="South" />
                                            <Button Content="East" Command="{Binding PulseCommand}" CommandParameter="East" />
                                            <Button Content="West" Command="{Binding PulseCommand}" CommandParameter="West" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowMoveAxis}">
                                <TextBlock Classes="eyebrow" Text="MOVE AXIS" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <ctl:FieldRow Label="Rate" Unit="°/s"><TextBox Text="{Binding AxisRateText}" /></ctl:FieldRow>
                                        <TextBlock Classes="secondary" Text="{Binding AxisRateHint}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Primary +" Command="{Binding MoveAxisCommand}" CommandParameter="Primary+" />
                                            <Button Content="Primary −" Command="{Binding MoveAxisCommand}" CommandParameter="Primary-" />
                                            <Button Content="Secondary +" Command="{Binding MoveAxisCommand}" CommandParameter="Secondary+" IsVisible="{Binding ShowSecondaryAxis}" />
                                            <Button Content="Secondary −" Command="{Binding MoveAxisCommand}" CommandParameter="Secondary-" IsVisible="{Binding ShowSecondaryAxis}" />
                                            <Button Classes="danger" Content="Stop" Command="{Binding StopAxesCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </equipment:DeviceDetailShell.ControlsContent>

        <equipment:DeviceDetailShell.SettingsContent>
            <ContentControl Content="{Binding Control}" IsVisible="{Binding Control, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:MountControlViewModel">
                        <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                            <StackPanel Spacing="12" IsVisible="{Binding ShowGuideRates}">
                                <TextBlock Classes="eyebrow" Text="GUIDE RATES" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <ctl:FieldRow Label="Right ascension" Unit="°/s"><TextBox Text="{Binding GuideRateRaText}" /></ctl:FieldRow>
                                        <ctl:FieldRow Label="Declination" Unit="°/s"><TextBox Text="{Binding GuideRateDecText}" /></ctl:FieldRow>
                                        <Button Classes="primary" Content="Apply" Command="{Binding ApplyGuideRatesCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowRefraction}">
                                <TextBlock Classes="eyebrow" Text="REFRACTION" />
                                <Border Classes="panel">
                                    <StackPanel Spacing="16">
                                        <CheckBox Content="The mount corrects for refraction" IsChecked="{Binding Refraction}" />
                                        <Button Classes="primary" Content="Apply" Command="{Binding ApplyRefractionCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </equipment:DeviceDetailShell.SettingsContent>
    </equipment:DeviceDetailShell>
</UserControl>
