<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:fw="using:Astra.Core.FilterWheels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             x:Class="Astra.Desktop.Views.Equipment.DeviceDetails.FilterWheelDetailsView"
             x:DataType="vm:FilterWheelDetailViewModel">

    <!-- A filter wheel: the filter in the light path and its slots, and a change to another slot -->
    <equipment:DeviceDetailShell>
        <equipment:DeviceDetailShell.OverviewContent>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="STATUS" />
                    <Border Classes="panel">
                        <StackPanel Spacing="2">
                            <ctl:InfoRow Label="Filter" Value="{Binding Wheel.CurrentFilterText}" />
                            <ctl:InfoRow Label="Slot" Value="{Binding Wheel.SlotText}" />
                            <ctl:InfoRow Label="Motion" Value="{Binding Wheel.MotionText}" IsVisible="{Binding Wheel.IsConnected}" />
                            <ctl:InfoRow Label="Part of" Value="{Binding RigText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Classes="eyebrow" Text="SLOTS" />
                    <Border Classes="panel">
                        <ItemsControl ItemsSource="{Binding Wheel.Filters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fw:FilterSlot">
                                    <Grid ColumnDefinitions="140,*" MinHeight="28">
                                        <TextBlock Classes="secondary" Text="{Binding Index, StringFormat={}Slot {0}}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </equipment:DeviceDetailShell.OverviewContent>

        <equipment:DeviceDetailShell.ControlsContent>
            <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Classes="eyebrow" Text="CHANGE FILTER" />
                <Border Classes="panel">
                    <StackPanel Spacing="16">
                        <ctl:LabeledField Label="Change to">
                            <ComboBox ItemsSource="{Binding Wheel.Filters}" SelectedItem="{Binding Wheel.SelectedFilter}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="fw:FilterSlot">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="meta" Text="{Binding Index}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctl:LabeledField>
                        <Button Classes="primary" Content="Change" Command="{Binding Wheel.ChangeCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </equipment:DeviceDetailShell.ControlsContent>
    </equipment:DeviceDetailShell>
</UserControl>
