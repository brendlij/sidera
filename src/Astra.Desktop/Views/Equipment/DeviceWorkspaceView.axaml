<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:equipment="using:Astra.Desktop.Views.Equipment"
             xmlns:workspaces="using:Astra.Desktop.Views.Equipment.Workspaces"
             x:Class="Astra.Desktop.Views.Equipment.DeviceWorkspaceView"
             x:DataType="vm:EquipmentViewModel">

    <!--
        The page of one kind of device. Among the standalone devices a chooser selects which device the page controls (only
        when there are several); in a rig the device is the one the rig names. Then the header with the connection, and the
        workspace of the kind, which is a set of sections that use the whole width.
    -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="20">
        <ctl:LabeledField Label="Device" MaxWidth="460" HorizontalAlignment="Left" IsVisible="{Binding HasDeviceChooser}">
            <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding ChosenDevice, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Device">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceViewModelBase">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Classes="meta" Text="{Binding BackendText}" VerticalAlignment="Center" />
                            <TextBlock Classes="meta" Text="{Binding StatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ctl:LabeledField>

        <ContentControl Grid.Row="1" Content="{Binding SelectedDetail}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:DeviceDetailViewModel">
                    <workspaces:DeviceHeaderView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <Panel Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding SelectedDetail}" HorizontalContentAlignment="Stretch">
                    <ContentControl.ContentTemplate>
                        <equipment:DeviceWorkspaceTemplate />
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <ctl:EmptyState Icon="{StaticResource IconEquipment}" Title="Not configured" Message="{Binding MissingDeviceText}" IsVisible="{Binding HasMissingDevice}" />
        </Panel>
    </Grid>
</UserControl>
