<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             xmlns:conv="using:Astra.Desktop.Converters"
             x:Class="Astra.Desktop.Views.Equipment.RigOverviewView"
             x:DataType="vm:RigViewModel">

    <!-- A rig at a glance: its optics, and each of its devices with its state and a way to its page. The controls are on the device pages. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="32" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="page-title" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="meta" Text="{Binding RigIdText}" />
                        <TextBlock Classes="meta" Text="{Binding OpticsText}" />
                    </StackPanel>
                </StackPanel>
                <ctl:StatusIndicator Grid.Column="1" Kind="{Binding StatusKind}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RigMemberViewModel">
                        <ctl:WorkspaceSection Header="{Binding Role, Converter={x:Static conv:UpperCaseConverter.Instance}}" Width="320" IsVisible="{Binding IsConfigured}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="{Binding NameText}" />
                                <ctl:StatusIndicator Kind="{Binding Device.StatusKind}" Text="{Binding Device.StatusText}" HorizontalAlignment="Left" />
                                <TextBlock Classes="secondary" Text="{Binding Device.ActivityText}" IsVisible="{Binding Device.IsConnected}" />
                                <Button Content="Open" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        AutomationProperties.Name="{Binding Role, StringFormat=Open {0}}" />
                            </StackPanel>
                        </ctl:WorkspaceSection>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel>
                <ctl:WorkspaceSection Header="OPTICS">
                    <StackPanel Spacing="2">
                        <ctl:InfoRow Label="Focal length" Value="{Binding FocalLengthText}" />
                        <ctl:InfoRow Label="Aperture" Value="{Binding ApertureText}" />
                        <ctl:InfoRow Label="Pixel size" Value="{Binding PixelSizeText}" />
                        <ctl:InfoRow Label="Sensor" Value="{Binding SensorText}" />
                        <ctl:InfoRow Label="Resolution" Value="{Binding ResolutionText}" />
                    </StackPanel>
                </ctl:WorkspaceSection>
                <ctl:WorkspaceSection Header="STATE">
                    <StackPanel Spacing="2">
                        <ctl:InfoRow Label="Camera" Value="{Binding ActivityText}" />
                        <ctl:InfoRow Label="Focus" Value="{Binding FocusText}" IsVisible="{Binding HasFocuser}" />
                        <ctl:InfoRow Label="Filter" Value="{Binding FilterText}" IsVisible="{Binding HasFilterWheel}" />
                    </StackPanel>
                </ctl:WorkspaceSection>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
