<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             x:Class="Astra.Desktop.Views.Equipment.RigBrowserView"
             x:DataType="vm:EquipmentViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:RigViewModel">
            <Button Classes="nav" Classes.active="{Binding IsSelected}" Command="{Binding OpenCommand}"
                    AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="48">
                    <Border Classes="navMarker" />
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="meta" Text="{Binding OpticsShortText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ctl:StatusIndicator Grid.Column="2" Margin="0,0,4,0" Kind="{Binding StatusKind}" AutomationProperties.Name="{Binding StatusText}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- The configured rigs, one quiet row each: the name, its optics and a dot for the state of its devices -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Margin="12,0,0,4" Text="RIGS" />
            <ItemsControl ItemsSource="{Binding Rigs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
