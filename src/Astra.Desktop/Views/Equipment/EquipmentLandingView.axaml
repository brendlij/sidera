<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             x:Class="Astra.Desktop.Views.Equipment.EquipmentLandingView"
             x:DataType="vm:EquipmentViewModel">

    <!--
        The overview of all the equipment: each rig with its devices, then the devices that belong to no rig, one line each with
        their state. A line opens the page of its device. This is an overview, not a wall of cards.
    -->
    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasLandingGroups}">
            <ItemsControl ItemsSource="{Binding LandingGroups}" MaxWidth="1100" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="40" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EquipmentLandingGroupViewModel">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="section-title" Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Rig.OpticsShortText}" IsVisible="{Binding IsRig}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="meta" Text="{Binding SummaryText}" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Classes="ghost" Content="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsRig}"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Open {0}}" />
                            </Grid>
                            <Border Classes="divider" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EquipmentLandingRow">
                                        <Button Classes="ghost" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid ColumnDefinitions="160,*,Auto,200" MinHeight="36">
                                                <TextBlock Classes="secondary" Text="{Binding Role}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="meta" Text="{Binding Device.ActivityText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                                <ctl:StatusIndicator Grid.Column="3" Kind="{Binding Device.StatusKind}" Text="{Binding Device.StatusText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ctl:EmptyState Icon="{StaticResource IconEquipment}" Margin="0,96" Title="No devices"
                        Message="Devices appear here when they are added to Astra: a camera, a focuser or a mount through an ASCOM driver, or one of the built-in simulators. Rigs are optional."
                        IsVisible="{Binding !HasLandingGroups}">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanManage}">
                <Button Classes="primary" Content="Add device" Command="{Binding AddDeviceCommand}" AutomationProperties.Name="Add first device" />
                <Button Content="Add simulated demo" Command="{Binding AddDemoEquipmentCommand}" AutomationProperties.Name="Add simulated demo" />
            </StackPanel>
        </ctl:EmptyState>
    </Panel>
</UserControl>
