<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             x:Class="Astra.Desktop.Views.Equipment.EquipmentModeSelector"
             x:DataType="vm:EquipmentViewModel">

    <!-- Devices or Rigs. Only offered with rigs: without any there is nothing to switch to. -->
    <StackPanel Orientation="Horizontal" Spacing="4">
        <RadioButton Classes="segment" Content="Devices" IsChecked="{Binding IsDevicesMode, Mode=TwoWay}" />
        <RadioButton Classes="segment" Content="Rigs" IsChecked="{Binding IsRigsMode, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
