<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:ctl="using:Astra.Desktop.Controls"
             x:Class="Astra.Desktop.Views.Equipment.DeviceConfigurationView"
             x:DataType="vm:DeviceConfigurationViewModel">

    <!--
        How the device is configured in Astra: what drives it, and what can be done with that. A device that is connected
        cannot be changed, and one that a rig or the sequence uses cannot be removed: the panel says so.
    -->
    <StackPanel Spacing="16">
        <TextBlock Classes="eyebrow" Text="CONFIGURATION" />
        <StackPanel Spacing="2">
            <ctl:InfoRow Label="Backend" Value="{Binding BackendText}" />
            <ctl:InfoRow Label="Driver" Value="{Binding DriverText}" />
        </StackPanel>

        <TextBlock Classes="secondary" Text="{Binding EditBlockText}" TextWrapping="Wrap" IsVisible="{Binding HasEditBlock}" />
        <TextBlock Classes="secondary" Text="{Binding RemoveBlockText}" TextWrapping="Wrap" IsVisible="{Binding HasRemoveBlock}" />
        <TextBlock Classes="secondary danger" Text="{Binding MessageText}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Edit…" Command="{Binding EditCommand}" AutomationProperties.Name="Edit device" />
            <Button Content="Setup driver…" Command="{Binding SetupDriverCommand}" IsVisible="{Binding IsAscom}"
                    AutomationProperties.Name="Setup driver of device" />
            <Button Classes="danger" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding !IsConfirmingRemove}"
                    AutomationProperties.Name="Remove device" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingRemove}">
                <TextBlock Classes="secondary" Text="Remove this device from Astra?" VerticalAlignment="Center" />
                <Button Classes="danger" Content="Remove device" Command="{Binding ConfirmRemoveCommand}" AutomationProperties.Name="Confirm remove device" />
                <Button Content="Keep" Command="{Binding CancelRemoveCommand}" AutomationProperties.Name="Keep device" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
