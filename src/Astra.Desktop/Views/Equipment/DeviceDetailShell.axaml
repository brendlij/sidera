<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Astra.Desktop.ViewModels"
             xmlns:conv="using:Astra.Desktop.Converters"
             xmlns:ctl="using:Astra.Desktop.Controls"
             x:Name="Root"
             x:Class="Astra.Desktop.Views.Equipment.DeviceDetailShell"
             x:DataType="vm:DeviceDetailViewModel">

    <!--
        What every device detail has: who the device is, its connection (and the one button that changes it), a failure,
        and the four tabs. What is in the Overview, the Controls and the Settings belongs to the kind of device: its own
        view puts it into the slots of this one. The Driver Info is the same for every device.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="{Binding Device.KindTitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                <TextBlock Classes="page-title" Text="{Binding Device.Name}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="meta" Text="{Binding Device.DeviceIdText}" />
                    <TextBlock Classes="meta" Text="{Binding Device.BackendText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ctl:StatusIndicator Kind="{Binding Device.StatusKind}" Text="{Binding Device.StatusText}" />
                <TextBlock Classes="secondary" Text="{Binding Device.ActivityText, StringFormat={}/ {0}}" VerticalAlignment="Center"
                           IsVisible="{Binding Device.IsConnected}" />
                <Button Content="Connect" Command="{Binding Device.ConnectCommand}" IsVisible="{Binding Device.IsDisconnected}" />
                <Button Content="Disconnect" Command="{Binding Device.DisconnectCommand}" IsVisible="{Binding Device.IsConnected}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="notice-danger" IsVisible="{Binding Device.HasError}">
            <TextBlock Classes="danger" Text="{Binding Device.ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Classes="tab" Content="Overview" IsChecked="{Binding IsOverviewSection, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Controls" IsChecked="{Binding IsControlsSection, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Settings" IsChecked="{Binding IsSettingsSection, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Driver Info" IsChecked="{Binding IsDriverInfoSection, Mode=TwoWay}" />
            </StackPanel>
            <Border Grid.Row="1" Classes="divider" />
        </Grid>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,8,0,0">
                <ContentPresenter Content="{Binding #Root.OverviewContent}" IsVisible="{Binding IsOverviewSection}" />
                <ContentPresenter Content="{Binding #Root.ControlsContent}" IsVisible="{Binding IsControlsSection}" />

                <!-- The settings of the kind of device; until it has any, the place says what will be here -->
                <StackPanel IsVisible="{Binding IsSettingsSection}">
                    <ContentPresenter Content="{Binding #Root.SettingsContent}" />
                    <ctl:EmptyState Icon="{StaticResource IconSettings}" Margin="0,48" Title="No settings yet"
                                    Message="{Binding NoSettingsText}"
                                    IsVisible="{Binding #Root.SettingsContent, Converter={x:Static ObjectConverters.IsNull}}" />
                </StackPanel>

                <Border Classes="panel" IsVisible="{Binding IsDriverInfoSection}">
                    <StackPanel Spacing="2">
                        <ctl:InfoRow Label="Device ID" Value="{Binding Device.DeviceIdText}" />
                        <ctl:InfoRow Label="Type" Value="{Binding Device.KindTitle}" />
                        <ctl:InfoRow Label="Backend" Value="{Binding Device.BackendText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
