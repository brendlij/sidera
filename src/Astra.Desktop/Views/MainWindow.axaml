<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Astra.Desktop.ViewModels"
        xmlns:app="using:Astra.Desktop"
        xmlns:conv="using:Astra.Desktop.Converters"
        xmlns:fw="using:Astra.Core.FilterWheels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Astra.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700" MinWidth="820" MinHeight="560"
        Background="{DynamicResource AstraBackground}"
        Foreground="{DynamicResource AstraText}"
        FontSize="13"
        Title="Astra">

    <Window.Resources>
        <!-- One line of a sequence: a draft row while idle, a row of the running snapshot while it runs -->
        <DataTemplate x:Key="SequenceNodeRow" x:DataType="vm:SequenceNodeViewModel">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4">
                <Border Width="{Binding IndentWidth}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding NumberText}" IsVisible="{Binding HasNumber}"
                           MinWidth="34" Margin="0,0,6,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="2" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Glyph}" />
                        <TextBlock Text="{Binding Title}" Classes.current="{Binding IsActive}"
                                   Classes.container="{Binding IsContainer}" Classes.danger="{Binding IsFailedNode}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SubText}" IsVisible="{Binding HasSubText}" Classes="muted"
                               Classes.danger="{Binding IsProblem}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IterationText}" IsVisible="{Binding HasIteration}" Classes="muted" />
                    <TextBlock Text="{Binding ActiveNote}" IsVisible="{Binding HasNote}" Classes="current" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Detail}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProblemLine" x:DataType="x:String">
            <TextBlock Classes="danger" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
        </DataTemplate>

        <!-- What the sequence is doing and the buttons that control it -->
        <DataTemplate x:Key="SequenceRunPanel" x:DataType="vm:SequencerViewModel">
            <StackPanel Spacing="18">
                <TextBlock Text="{Binding ReadinessHint}" IsVisible="{Binding HasReadinessHint}" TextWrapping="Wrap" Classes="muted" />
                <!-- What the whole session does at the moment: a dither of the shared mount, from the running positions -->
                <StackPanel Spacing="2" IsVisible="{Binding HasSharedActivity}">
                    <TextBlock Classes="section" Text="SHARED" />
                    <TextBlock Classes="current" Text="{Binding SharedActivity}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- What the autofocus of each rig reports: sample, position and HFR, then the best focus -->
                <ItemsControl ItemsSource="{Binding AutofocusStatuses}" IsVisible="{Binding HasAutofocus}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AutofocusStatusViewModel">
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                                <TextBlock Classes="section" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="current" Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Live execution: nested position, current step, exposure progress -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowStatusLines}">
                    <ItemsControl ItemsSource="{Binding StatusLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SequenceStatusLine">
                                <TextBlock Text="{Binding Text}" Margin="0,2"
                                           Classes.muted="{Binding IsContainer}"
                                           Classes.current="{Binding !IsContainer}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding ActiveBranches}" IsVisible="{Binding HasActiveBranches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActiveBranchViewModel">
                            <StackPanel Spacing="4" Margin="0,4">
                                <TextBlock Text="{Binding BranchName}" IsVisible="{Binding HasBranchName}" />
                                <TextBlock Text="{Binding Context}" IsVisible="{Binding HasContext}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DisplayTitle}" Classes="current" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Camera.ExposureProgress}" IsVisible="{Binding HasProgress}" />
                                <TextBlock Text="{Binding Camera.ExposureProgressText}" IsVisible="{Binding HasProgress}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <Button Classes="accent" Content="Run Sequence" Command="{Binding RunCommand}" />
                    <Button Content="Pause" Command="{Binding PauseCommand}" />
                    <Button Content="Resume" Command="{Binding ResumeCommand}" />
                    <Button Content="Cancel Sequence" Command="{Binding CancelCommand}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:CameraViewModel}" x:DataType="vm:CameraViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="title" Text="{Binding Name}" />
                            <TextBlock Classes="muted" Text="{Binding Kind}" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" Classes.ok="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" />
                                <TextBlock Text="{Binding ConnectionState}" />
                            </StackPanel>
                        </Border>
                    </Grid>



                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="badge" Classes.running="{Binding IsExposing}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" />
                                <TextBlock Text="{Binding ExposureState}" />
                            </StackPanel>
                        </Border>
                        <ProgressBar Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1" Value="{Binding ExposureProgress}"
                                     IsVisible="{Binding IsExposing}" />
                        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                                   Text="{Binding ExposureProgressText}"
                                   IsVisible="{Binding IsExposing}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        <Button Classes="accent" Content="Start Exposure" Command="{Binding StartExposureCommand}" />
                        <Button Content="Cancel Exposure" Command="{Binding CancelExposureCommand}"
                                IsVisible="{Binding IsManualExposureRunning}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="danger" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </Grid>
            </Border>


        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SequencerViewModel}" x:DataType="vm:SequencerViewModel">
            <Border Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="18">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section" Text="SEQUENCE" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="badge"
                                Classes.running="{Binding IsRunningState}" Classes.paused="{Binding IsPauseState}"
                                Classes.ok="{Binding IsCompleted}"
                                Classes.warn="{Binding IsCancelled}"
                                Classes.danger="{Binding IsFailed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" />
                                <TextBlock Text="{Binding StateText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Read-only outline of the sequence: the draft while idle, the running snapshot while it runs -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="muted" Text="{Binding SequenceName}" />
                        <Border Classes="inset">
                            <StackPanel>
                                <TextBlock Classes="muted" Text="Add a step to create a sequence." Margin="0,4"
                                           IsVisible="{Binding IsEmpty}" />
                                <ItemsControl ItemsSource="{Binding Definition}"
                                              ItemTemplate="{StaticResource SequenceNodeRow}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SequenceRunPanel}" />
                </StackPanel>
            </Border>

        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SequencerPageViewModel}" x:DataType="vm:SequencerPageViewModel">
            <StackPanel Spacing="16">
            <!-- The sequence as a document: its file, whether it has unsaved changes, and what can be done with it -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="{Binding Document.DisplayName}" />
                    <Border Classes="badge warn" IsVisible="{Binding Document.IsDirty}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Classes="dot" />
                            <TextBlock Text="Modified" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                    <Button Content="New" Command="{Binding Document.NewCommand}" />
                    <Button Content="Open…" Command="{Binding Document.OpenCommand}" />
                    <Button Content="Save" Command="{Binding Document.SaveCommand}" />
                    <Button Content="Save As…" Command="{Binding Document.SaveAsCommand}" />
                </WrapPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Document.IsConfirmingDiscard}">
                <TextBlock Text="Discard unsaved changes?" VerticalAlignment="Center" />
                <Button Classes="accent" Content="Discard" Command="{Binding Document.ConfirmDiscardCommand}" />
                <Button Content="Cancel" Command="{Binding Document.CancelDiscardCommand}" />
            </StackPanel>
            <TextBlock Classes="danger" Text="{Binding Document.ErrorMessage}" IsVisible="{Binding Document.HasError}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,360" ColumnSpacing="20">
                <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="SEQUENCE STEPS" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="badge"
                                    Classes.running="{Binding Sequencer.IsRunningState}" Classes.paused="{Binding Sequencer.IsPauseState}"
                                    Classes.ok="{Binding Sequencer.IsCompleted}"
                                    Classes.warn="{Binding Sequencer.IsCancelled}"
                                    Classes.danger="{Binding Sequencer.IsFailed}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="dot" />
                                    <TextBlock Text="{Binding Sequencer.StateText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                            <Button Content="Add step ▾" IsEnabled="{Binding Draft.IsEditable}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Exposure" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Exposure}" />
                                        <MenuItem Header="Delay" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Delay}" />
                                        <MenuItem Header="Slew" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Slew}" />
                                        <MenuItem Header="Start Guiding" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.StartGuiding}" />
                                        <MenuItem Header="Stop Guiding" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.StopGuiding}" />
                                        <MenuItem Header="Dither" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Dither}" />
                                        <MenuItem Header="Move Focuser" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.MoveFocuser}" />
                                        <MenuItem Header="Change Filter" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.ChangeFilter}" />
                                        <MenuItem Header="Autofocus" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Autofocus}" />
                                        <MenuItem Header="Repeat" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Repeat}" />
                                        <MenuItem Header="Multi-Rig Imaging" Command="{Binding Draft.AddStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.MultiRig}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Add Rig Track" Command="{Binding Draft.AddTrackCommand}" IsVisible="{Binding Draft.IsMultiRigContext}" />
                            <Button Content="Add step in track ▾" IsEnabled="{Binding Draft.IsEditable}" IsVisible="{Binding Draft.IsMultiRigContext}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Exposure" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Exposure}" />
                                        <MenuItem Header="Delay" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Delay}" />
                                        <MenuItem Header="Move Focuser" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.MoveFocuser}" />
                                        <MenuItem Header="Change Filter" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.ChangeFilter}" />
                                        <MenuItem Header="Autofocus" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Autofocus}" />
                                        <MenuItem Header="Repeat" Command="{Binding Draft.AddTrackStepCommand}" CommandParameter="{x:Static app:SequenceStepKind.Repeat}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Add inside Repeat ▾" IsEnabled="{Binding Draft.CanAddChildHere}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Exposure" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.Exposure}" />
                                        <MenuItem Header="Delay" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.Delay}" />
                                        <MenuItem Header="Slew" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.Slew}" />
                                        <MenuItem Header="Start Guiding" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.StartGuiding}" />
                                        <MenuItem Header="Stop Guiding" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.StopGuiding}" />
                                        <MenuItem Header="Dither" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.Dither}" />
                                        <MenuItem Header="Move Focuser" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.MoveFocuser}" />
                                        <MenuItem Header="Change Filter" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.ChangeFilter}" />
                                        <MenuItem Header="Autofocus" Command="{Binding Draft.AddChildCommand}" CommandParameter="{x:Static app:SequenceStepKind.Autofocus}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Duplicate" Command="{Binding Draft.DuplicateStepCommand}" />
                            <Button Content="Copy" Command="{Binding Draft.CopyStepCommand}" />
                            <Button Content="Paste" Command="{Binding Draft.PasteStepCommand}" />
                            <Button Content="Remove" Command="{Binding Draft.RemoveStepCommand}" />
                            <Button Content="Move Up" Command="{Binding Draft.MoveStepUpCommand}" />
                            <Button Content="Move Down" Command="{Binding Draft.MoveStepDownCommand}" />
                        </WrapPanel>

                        <!-- The draft while nothing runs -->
                        <StackPanel IsVisible="{Binding !Sequencer.IsRunning}">
                            <ListBox Classes="steps" ItemsSource="{Binding Draft.Rows}" SelectedItem="{Binding Draft.SelectedStep}"
                                     IsVisible="{Binding !Draft.IsEmpty}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepDraftViewModel">
                                        <Grid ColumnDefinitions="Auto,52,*,Auto">
                                            <!-- Steps inside a Repeat are indented, next to a thin rule -->
                                            <Grid Width="{Binding IndentWidth}">
                                                <Border Width="2" HorizontalAlignment="Left" Margin="8,0,0,0" CornerRadius="1"
                                                        Background="{DynamicResource AstraHover}" IsVisible="{Binding IsChild}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding NumberLabel}" Classes="muted" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding IsContainer}" />
                                                <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsContainer}" />
                                                <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"
                                                           IsVisible="{Binding !HasProblems}" />
                                                <TextBlock Text="{Binding FirstProblem}" Classes="muted danger" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasProblems}" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Classes="badge danger" IsVisible="{Binding HasProblems}" VerticalAlignment="Top">
                                                <TextBlock Text="⚠ Invalid" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="muted" Text="Add a step to create a sequence." Margin="0,8"
                                       IsVisible="{Binding Draft.IsEmpty}" />
                        </StackPanel>

                        <!-- The snapshot of the running sequence, with where it is -->
                        <Border Classes="inset" IsVisible="{Binding Sequencer.IsRunning}">
                            <ItemsControl ItemsSource="{Binding Sequencer.Definition}"
                                          ItemTemplate="{StaticResource SequenceNodeRow}" />
                        </Border>

                        <ContentControl Content="{Binding Sequencer}" ContentTemplate="{StaticResource SequenceRunPanel}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                    <!-- What the whole session shares: one mount, usually one guider -->
                    <Border Classes="card">
                        <StackPanel Spacing="10" DataContext="{Binding Shared}" x:DataType="vm:SharedEquipmentViewModel">
                            <TextBlock Classes="section" Text="SHARED EQUIPMENT" />
                            <StackPanel Spacing="10" IsEnabled="{Binding Draft.IsEditable}">
                                <TextBlock Classes="muted" Text="Mount" />
                                <ContentControl Content="{Binding Mount}" />
                                <TextBlock Classes="muted" Text="{Binding MountText}" />
                                <TextBlock Classes="muted" Text="Guider" Margin="0,4,0,0" />
                                <ContentControl Content="{Binding Guider}" />
                                <TextBlock Classes="muted" Text="{Binding GuiderText}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Draft.SharedProblems}" ItemTemplate="{StaticResource ProblemLine}"
                                          IsVisible="{Binding Draft.HasSharedProblems}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="section" Text="SELECTED STEP" />
                            <TextBlock Classes="muted" Text="Select a step to edit it."
                                       IsVisible="{Binding Draft.SelectedStep, Converter={x:Static ObjectConverters.IsNull}}" />
                            <ContentControl Content="{Binding Draft.SelectedStep}" IsEnabled="{Binding Draft.IsEditable}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicePickerViewModel}" x:DataType="vm:DevicePickerViewModel">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceOption">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Classes="muted" Text="{Binding IdText}" IsVisible="{Binding HasIdText}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilterChoiceViewModel}" x:DataType="vm:FilterChoiceViewModel">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterOption">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Classes="muted" Text="{Binding DetailText}" IsVisible="{Binding HasDetail}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoveFocuserStepDraftViewModel}" x:DataType="vm:MoveFocuserStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Move Focuser" />
                <TextBlock Classes="muted" Text="Focuser" />
                <ContentControl Content="{Binding Focuser}" />
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Position" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PositionText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="steps" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding RangeLabel, StringFormat='Range: {0} steps'}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangeFilterStepDraftViewModel}" x:DataType="vm:ChangeFilterStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Change Filter" />
                <TextBlock Classes="muted" Text="Filter wheel" />
                <ContentControl Content="{Binding Wheel}" />
                <TextBlock Classes="muted" Text="Filter" />
                <ContentControl Content="{Binding Filter}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigMoveFocuserStepDraftViewModel}" x:DataType="vm:RigMoveFocuserStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Move Focuser" />
                <TextBlock Classes="muted" Text="Moves the focuser of the rig of this track." />
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Position" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PositionText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="steps" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding Summary}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigChangeFilterStepDraftViewModel}" x:DataType="vm:RigChangeFilterStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Change Filter" />
                <TextBlock Classes="muted" Text="Turns the filter wheel of the rig of this track." />
                <TextBlock Classes="muted" Text="Filter" />
                <ContentControl Content="{Binding Filter}" />
                <TextBlock Classes="muted" Text="{Binding Summary}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutofocusStepDraftViewModel}" x:DataType="vm:AutofocusStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Autofocus" />
                <TextBlock Classes="muted" Text="Rig" />
                <ContentControl Content="{Binding Rig}" />
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Exposure" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ExposureText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Step size" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding StepSizeText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="steps" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Samples" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SamplesText}" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Takes exposures with the camera of the rig at positions around the current focuser position, fits the focus curve and moves the focuser of the rig to the best one. The filter that is in place is used; nothing else moves." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigAutofocusStepDraftViewModel}" x:DataType="vm:RigAutofocusStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Autofocus" />
                <TextBlock Classes="muted" Text="Focuses the rig of this track: its camera and its focuser." />
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Exposure" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ExposureText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Step size" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding StepSizeText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="steps" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,50">
                    <TextBlock Text="Samples" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SamplesText}" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding Summary}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="The other rigs go on while this one focuses. A dither of the shared mount waits until it is done." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExposureStepDraftViewModel}" x:DataType="vm:ExposureStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Exposure" />
                <TextBlock Classes="muted" Text="Camera" />
                <ContentControl Content="{Binding Camera}" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Exposure" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ExposureText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigPickerViewModel}" x:DataType="vm:RigPickerViewModel">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RigOption">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Classes="muted" Text="{Binding DetailText}" IsVisible="{Binding HasDetail}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MultiRigStepDraftViewModel}" x:DataType="vm:MultiRigStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Multi-Rig Imaging" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Each Rig Track images with one rig, at the same time as the others. The mount and the guider are shared by the session: slewing and guiding stay outside, before and after. The block ends when every track has ended." />

                <!-- When the block dithers the shared mount: Astra makes the tracks wait for each other, the user says when -->
                <TextBlock Classes="section" Text="DITHER POLICY" Margin="0,6,0,0" />
                <CheckBox Content="Enabled" IsChecked="{Binding DitherEnabled}" />
                <StackPanel Spacing="14" IsEnabled="{Binding DitherEnabled}">
                    <TextBlock Classes="muted" Text="Trigger" />
                    <ContentControl Content="{Binding TriggerRig}" />
                    <Grid ColumnDefinitions="*,110,60">
                        <TextBlock Text="Every" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DitherEveryText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="frames" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,110,60">
                        <TextBlock Text="Amplitude" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DitherAmplitudeText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,110,60">
                        <TextBlock Text="Settle threshold" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DitherSettleThresholdText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,110,60">
                        <TextBlock Text="Stable for" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DitherSettleStableText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,110,60">
                        <TextBlock Text="Timeout" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DitherSettleTimeoutText}" />
                        <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="After this many completed frames of the trigger rig, every rig finishes what it is doing and waits; then the shared mount dithers, guiding settles, and all rigs go on." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigTrackDraftViewModel}" x:DataType="vm:RigTrackDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Rig Track" />
                <TextBlock Classes="muted" Text="Rig" />
                <ContentControl Content="{Binding Rig}" />
                <TextBlock Classes="muted" Text="{Binding Summary}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Use “Add step in track” for what this rig does: exposures with its camera, moving its focuser, changing its filter, delays, and Repeats of those." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigExposureStepDraftViewModel}" x:DataType="vm:RigExposureStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Exposure" />
                <TextBlock Classes="muted" Text="Uses the camera of the rig of this track." />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Exposure" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ExposureText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepeatStepDraftViewModel}" x:DataType="vm:RepeatStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Repeat" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Repeat count" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding CountText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="×" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="The steps inside run in order, once per repetition. Select the Repeat or a step inside it and use “Add inside Repeat” to add more." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DelayStepDraftViewModel}" x:DataType="vm:DelayStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Delay" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Duration" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DurationText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SlewStepDraftViewModel}" x:DataType="vm:SlewStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Slew" />
                <TextBlock Classes="muted" Text="Mount" />
                <ContentControl Content="{Binding Mount}" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Right ascension" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding RightAscensionText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="h" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Declination" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DeclinationText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="°" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartGuidingStepDraftViewModel}" x:DataType="vm:StartGuidingStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Start Guiding" />
                <TextBlock Classes="muted" Text="Guider" />
                <ContentControl Content="{Binding Guider}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StopGuidingStepDraftViewModel}" x:DataType="vm:StopGuidingStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Stop Guiding" />
                <TextBlock Classes="muted" Text="Guider" />
                <ContentControl Content="{Binding Guider}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DitherStepDraftViewModel}" x:DataType="vm:DitherStepDraftViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="title" Text="Dither" />
                <TextBlock Classes="muted" Text="Guider" />
                <ContentControl Content="{Binding Guider}" />
                <TextBlock Classes="muted" Text="Mount" />
                <ContentControl Content="{Binding Mount}" />
                <TextBlock Classes="muted" Text="Affected camera" />
                <ContentControl Content="{Binding Camera}" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Amplitude" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AmplitudeText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" Text="Settle after dither" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Threshold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SettleThresholdText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="px" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Stable for" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SettleStableText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,110,36">
                    <TextBlock Text="Timeout" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SettleTimeoutText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="s" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EquipmentViewModel}" x:DataType="vm:EquipmentViewModel">
            <StackPanel Spacing="12">
                <TextBlock Classes="title" Text="Equipment" />
                <ItemsControl ItemsSource="{Binding Rigs}" />
                <ItemsControl ItemsSource="{Binding Cameras}" />
                <ItemsControl ItemsSource="{Binding Focusers}" />
                <ItemsControl ItemsSource="{Binding FilterWheels}" />
                <ItemsControl ItemsSource="{Binding Mounts}" />
                <ItemsControl ItemsSource="{Binding Guiders}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RigViewModel}" x:DataType="vm:RigViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="CAMERA" />
                        <TextBlock Text="{Binding CameraText}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="FOCUSER" />
                        <TextBlock Text="{Binding FocuserText}" Classes.muted="{Binding !HasFocuser}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="FILTER WHEEL" />
                        <TextBlock Text="{Binding FilterWheelText}" Classes.muted="{Binding !HasFilterWheel}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="OPTICS" />
                        <TextBlock Text="{Binding OpticsText}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Classes="muted" Text="{Binding ApertureText}" />
                            <TextBlock Classes="muted" Text="{Binding ResolutionText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FocuserViewModel}" x:DataType="vm:FocuserViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Classes="muted" Text="{Binding DeviceIdText}" />
                    <TextBlock Text="{Binding ConnectionState}" />
                    <TextBlock Text="{Binding PositionText}" />
                    <TextBlock Text="{Binding MotionState}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        <TextBox Width="120" PlaceholderText="Target position" Text="{Binding TargetInput}" />
                        <Button Content="Move" Command="{Binding MoveCommand}" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding RangeText}" />
                    <TextBlock Classes="danger" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilterWheelViewModel}" x:DataType="vm:FilterWheelViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Classes="muted" Text="{Binding DeviceIdText}" />
                    <TextBlock Text="{Binding ConnectionState}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding CurrentFilterText}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding SlotText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MotionState}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        <ComboBox Width="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="fw:FilterSlot">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Classes="muted" Text="{Binding Index}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Change" Command="{Binding ChangeCommand}" />
                    </StackPanel>
                    <TextBlock Classes="danger" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MountViewModel}" x:DataType="vm:MountViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Text="{Binding ConnectionState}" />
                    <TextBlock Text="{Binding MotionState}" />
                    <TextBlock Text="{Binding CoordinatesText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        <TextBox Width="100" PlaceholderText="RA (hours)" Text="{Binding RightAscensionInput}" />
                        <TextBox Width="100" PlaceholderText="Dec (degrees)" Text="{Binding DeclinationInput}" />
                        <Button Content="Slew" Command="{Binding SlewCommand}" />
                    </StackPanel>
                    <TextBlock Classes="danger" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuiderViewModel}" x:DataType="vm:GuiderViewModel">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Text="{Binding ConnectionState}" />
                    <TextBlock Text="{Binding GuidingState}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        <Button Content="Start Guiding" Command="{Binding StartGuidingCommand}" />
                        <Button Content="Stop Guiding" Command="{Binding StopGuidingCommand}" />
                    </StackPanel>
                    <TextBlock Classes="danger" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImagingViewModel}" x:DataType="vm:ImagingViewModel">
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="title" Text="Imaging" />
                    <Border Classes="preview" Height="360">
                        <Grid>
                            <Image Source="{Binding LatestFrame, Converter={x:Static conv:FrameToBitmapConverter.Instance}}" Stretch="Uniform" />
                            <TextBlock Text="No frame yet" Classes="muted" IsVisible="{Binding !HasFrame}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SourceText}" />
                    <TextBlock Text="{Binding DimensionsText}" />
                    <TextBlock Text="{Binding ExposureText}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}" x:DataType="vm:DashboardViewModel">
            <StackPanel Spacing="12">
                <TextBlock Classes="title" Text="Dashboard" />
                <TextBlock Text="{Binding Runtime.ModeText}" />
                <TextBlock Text="{Binding Runtime.HeldText}" />
                <TextBlock Text="{Binding Runtime.CoordinationText}" TextWrapping="Wrap" />
                <ContentControl Content="{Binding Sequencer}" />
                <ContentControl Content="{Binding Imaging}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>
    <Grid ColumnDefinitions="220,*">
        <Border Classes="sidebar">
            <StackPanel Margin="20,28,20,20" Spacing="8">
                <TextBlock Classes="wordmark" Text="ASTRA" Margin="12,0,0,28" />
                <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Dashboard}" Classes.accent="{Binding IsDashboardSelected}" />
                <Button Content="Equipment" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Equipment}" Classes.accent="{Binding IsEquipmentSelected}" />
                <Button Content="Sequencer" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Sequencer}" Classes.accent="{Binding IsSequencerSelected}" />
                <Button Content="Imaging" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Imaging}" Classes.accent="{Binding IsImagingSelected}" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" Margin="28">
            <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>
    </Grid>
</Window>
