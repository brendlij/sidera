<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Astra.Desktop.ViewModels"
        xmlns:conv="using:Astra.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
        x:Class="Astra.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        SizeToContent="WidthAndHeight"
        Title="Astra">

    <StackPanel Margin="24" Spacing="8">
        <TextBlock Text="ASTRA" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="{Binding CameraName}" FontSize="16" Margin="0,12,0,0" />
        <TextBlock Text="{Binding ConnectionState, StringFormat='Connection: {0}'}" />
        <TextBlock Text="{Binding ExposureState, StringFormat='Exposure: {0}'}" />

        <Border Background="Black" Width="400" Height="300" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Image Source="{Binding LastFrame, Converter={x:Static conv:FrameToBitmapConverter.Instance}}"
                   Stretch="Uniform" />
        </Border>

        <StackPanel IsVisible="{Binding IsExposing}" Spacing="4">
            <TextBlock Text="{Binding ExposureSummary}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ExposureProgress}"
                         ShowProgressText="True" ProgressTextFormat="{}{1:0}%" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Connect" Command="{Binding ConnectCommand}" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
        <Button Content="Start 5s Exposure" Command="{Binding StartExposureCommand}" />

        <TextBlock Text="SEQUENCE" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
        <TextBlock Text="{Binding SequenceState}" />
        <TextBlock Text="{Binding SequenceStepText}" />
        <TextBlock Text="{Binding CurrentStepName}" />
        <TextBlock Text="{Binding SequenceError}" Foreground="Red"
                   IsVisible="{Binding SequenceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Run Sequence" Command="{Binding RunSequenceCommand}" />
            <Button Content="Cancel Sequence" Command="{Binding CancelSequenceCommand}"
                    IsVisible="{Binding IsSequenceRunning}" />
        </StackPanel>
    </StackPanel>

</Window>
