<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASCOM COM backends for Sidera. Windows only: the drivers are COM objects registered on this machine.
    Everything ASCOM-specific stays in this project; Core and Runtime know nothing of it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidera.Core\Sidera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions are pinned on purpose: this is the combination that the compatibility spike proved on .NET 10. -->
    <PackageReference Include="ASCOM.Com.Components" Version="4.0.0" />
    <PackageReference Include="ASCOM.Common.Components" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sidera.Ascom.Tests" />
  </ItemGroup>

</Project>
