<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASTAP as a plate solver for Sidera: its command line, its output files and its star database. Everything of ASTAP stays in this project;
    Core, Runtime and Desktop only see IPlateSolver and the backend-neutral request and result.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidera.Core\Sidera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sidera.Astap.Tests" />
  </ItemGroup>

</Project>
