<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sky surveys and object catalogs for the Framing workspace: HiPS tiles from a remote survey, a disk cache for them, and the search for an object by name.
    Backend-neutral at its edge: the workspace sees ISkySurveyProvider and ICelestialObjectCatalog and no survey or catalog by name.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidera.Core\Sidera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sidera.Sky.Tests" />
  </ItemGroup>

</Project>
