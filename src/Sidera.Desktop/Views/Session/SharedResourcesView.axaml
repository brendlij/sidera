<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Session.SharedResourcesView"
             x:DataType="vm:WorkflowEditorViewModel">

    <!-- What the setups of the workflow share: a mount or a guider that more than one of them uses. Only there when there is something shared. -->
    <Border Classes="panel" Padding="20,16" Margin="0,8,0,0" IsVisible="{Binding HasSharedResources}">
        <StackPanel Spacing="6">
            <TextBlock Classes="eyebrow" Text="SHARED RESOURCES" />
            <ItemsControl ItemsSource="{Binding SharedResources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Classes="value" Text="{Binding}" AutomationProperties.AutomationId="WorkflowSharedResource" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="Setups that share a mount expose together; a dither, a flip or a slew of it waits for all of them. A guider that guides more than one setup is dithered once." />
        </StackPanel>
    </Border>
</UserControl>
