<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Session.ExecutionTracksView"
             x:DataType="vm:ExecutionOverviewViewModel">

    <!-- The imaging setups of a run, one lane each: where the sequence of the setup is and what the setup does. Only what is real is shown. -->
    <ItemsControl ItemsSource="{Binding Lanes}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackLaneViewModel">
                <Border Classes="panel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Classes="lane-bar" Classes.idle="{Binding IsWaiting}" Classes.ok="{Binding IsDone}"
                                Classes.danger="{Binding IsFailed}" />
                        <StackPanel Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="card-title" Text="{Binding Name}" />
                                    <TextBlock Classes="meta" Text="{Binding DescriptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ctl:StatusIndicator Grid.Column="1" Kind="{Binding StatusKind}" Text="{Binding StatusText}" />
                            </Grid>

                            <TextBlock Classes="value" Text="{Binding CurrentStep}" TextWrapping="Wrap" IsVisible="{Binding HasCurrentStep}" />
                            <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding Rig, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="meta" Text="{Binding Rig.FocusText, StringFormat={}Focus {0}}" IsVisible="{Binding Rig.HasFocuser}" />
                                <TextBlock Classes="meta" Text="{Binding Rig.FilterText, StringFormat={}Filter {0}}" IsVisible="{Binding Rig.HasFilterWheel}" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasExposure}">
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Camera.ExposureProgress}" />
                                <TextBlock Classes="meta" Text="{Binding Camera.ActivityText}" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasFrames}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="secondary" Text="{Binding FrameText}" />
                                </Grid>
                                <ProgressBar Classes="thick" Minimum="0" Maximum="1" Value="{Binding FrameProgress}" />
                            </StackPanel>

                            <TextBlock Classes="secondary accent" Text="{Binding FocusText, StringFormat={}Autofocus · {0}}" TextWrapping="Wrap"
                                       IsVisible="{Binding IsFocusing}" />
                            <TextBlock Classes="secondary" Text="{Binding FocusText}" TextWrapping="Wrap">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFocus" />
                                        <Binding Path="!IsFocusing" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
