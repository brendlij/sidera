<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Session.BlockConditionsView"
             x:DataType="vm:WorkflowRowViewModel">

    <StackPanel Spacing="12">
    <!-- All of these must hold before the block begins -->
    <StackPanel Spacing="6" DataContext="{Binding Start}" x:DataType="vm:ConditionTogglesViewModel">
        <TextBlock Classes="eyebrow" Text="START WHEN ALL" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="Target altitude above" IsChecked="{Binding AltitudeAboveOn}" AutomationProperties.AutomationId="BlockStartAltitude" />
            <TextBox Width="60" Text="{Binding AltitudeAboveText}" IsEnabled="{Binding AltitudeAboveOn}" AutomationProperties.AutomationId="BlockStartAltitudeValue" />
            <TextBlock Text="°" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox IsChecked="{Binding DarknessOn}" AutomationProperties.AutomationId="BlockStartDarkness" />
            <ComboBox ItemsSource="{x:Static vm:ConditionTogglesViewModel.TwilightNames}" SelectedItem="{Binding DarknessKind}" IsEnabled="{Binding DarknessOn}" Width="130" />
            <TextBlock Text="darkness" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="meta" Text="{Binding ExtrasText}" IsVisible="{Binding HasExtras}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Any of these ends the block, after the exposure that is running -->
    <StackPanel Spacing="6" DataContext="{Binding Stop}" x:DataType="vm:ConditionTogglesViewModel">
        <TextBlock Classes="eyebrow" Text="STOP WHEN ANY" />
        <CheckBox Content="Frames completed" IsChecked="True" IsEnabled="False" ToolTip.Tip="Always on: the frames of the block are its count." />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="Target altitude below" IsChecked="{Binding AltitudeBelowOn}" AutomationProperties.AutomationId="BlockStopAltitude" />
            <TextBox Width="60" Text="{Binding AltitudeBelowText}" IsEnabled="{Binding AltitudeBelowOn}" AutomationProperties.AutomationId="BlockStopAltitudeValue" />
            <TextBlock Text="°" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox IsChecked="{Binding DawnOn}" AutomationProperties.AutomationId="BlockStopDawn" />
            <ComboBox ItemsSource="{x:Static vm:ConditionTogglesViewModel.TwilightNames}" SelectedItem="{Binding DawnKind}" IsEnabled="{Binding DawnOn}" Width="130" />
            <TextBlock Text="dawn" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="Time" IsChecked="{Binding TimeOn}" AutomationProperties.AutomationId="BlockStopTime" />
            <TextBox Width="70" Text="{Binding TimeText}" IsEnabled="{Binding TimeOn}" AutomationProperties.AutomationId="BlockStopTimeValue" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="Duration" IsChecked="{Binding DurationOn}" AutomationProperties.AutomationId="BlockStopDuration" />
            <TextBox Width="60" Text="{Binding DurationText}" IsEnabled="{Binding DurationOn}" AutomationProperties.AutomationId="BlockStopDurationValue" />
            <TextBlock Text="h" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="meta" Text="{Binding ZoneText, StringFormat={}Times are read in {0}.}" TextWrapping="Wrap" />
        <TextBlock Classes="meta" Text="An exposure that is running is finished first." TextWrapping="Wrap" />
        <TextBlock Classes="meta" Text="{Binding ExtrasText}" IsVisible="{Binding HasExtras}" TextWrapping="Wrap" />
    </StackPanel>
    </StackPanel>
</UserControl>
