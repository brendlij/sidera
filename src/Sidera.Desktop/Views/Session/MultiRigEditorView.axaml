<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Session.MultiRigEditorView"
             x:DataType="vm:MultiRigStepDraftViewModel">

    <!--
        The inspector of a Multi-Rig block: the rigs that image at the same time, each as a lane with what it does, and the
        policy that makes them wait for each other when the shared mount dithers. The generic parallel step stays hidden:
        a user thinks in rigs.
    -->
    <StackPanel Spacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
            <TextBlock Classes="section-title" Text="Multi-Rig Imaging" />
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="Each Rig Track images with one rig, at the same time as the others. The mount and the guider are shared by the session: slewing and guiding stay outside, before and after. The block ends when every track has ended." />
        </StackPanel>

        <TextBlock Classes="eyebrow" Text="LANES" />
        <ItemsControl ItemsSource="{Binding Lanes}" IsVisible="{Binding HasLanes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LaneSummary">
                    <Border Classes="raised" Padding="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,10,12,10">
                            <Border Classes="lane-bar" Margin="10,0,0,0" Classes.danger="{Binding HasProblems}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="card-title" Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LaneLine">
                                            <TextBlock Classes="secondary" Text="{Binding Text}" TextWrapping="Wrap"
                                                       Classes.meta="{Binding IsNested}" Margin="0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="secondary accent" Text="{Binding Autofocus}" IsVisible="{Binding HasAutofocus}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="secondary" Text="No rig tracks yet. Use Add step, then Add Rig Track." IsVisible="{Binding !HasLanes}" />

        <Border Classes="divider" />

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Classes="card-title" Text="Dither policy" />
                <TextBlock Classes="meta" Text="Between frames" />
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding DitherEnabled}" />
        </Grid>
        <TextBlock Classes="value" Text="{Binding DitherSummary}" TextWrapping="Wrap" />

        <StackPanel Spacing="12" IsEnabled="{Binding DitherEnabled}">
            <ctl:LabeledField Label="Trigger rig"><ContentControl Content="{Binding TriggerRig}" /></ctl:LabeledField>
            <ctl:FieldRow Label="Every" Unit="frames"><TextBox Text="{Binding DitherEveryText}" /></ctl:FieldRow>
            <ctl:FieldRow Label="Amplitude" Unit="px"><TextBox Text="{Binding DitherAmplitudeText}" /></ctl:FieldRow>
            <ctl:FieldRow Label="Settle threshold" Unit="px"><TextBox Text="{Binding DitherSettleThresholdText}" /></ctl:FieldRow>
            <ctl:FieldRow Label="Stable for" Unit="s"><TextBox Text="{Binding DitherSettleStableText}" /></ctl:FieldRow>
            <ctl:FieldRow Label="Timeout" Unit="s"><TextBox Text="{Binding DitherSettleTimeoutText}" /></ctl:FieldRow>
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="After this many completed frames of the trigger rig, every rig finishes what it is doing and waits; then the shared mount dithers, guiding settles, and all rigs go on." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="secondary danger" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
