<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             x:Class="Sidera.Desktop.Views.Session.BlockCardView"
             x:DataType="vm:BlockCardViewModel">

    <!-- A block collapsed: its name and one line about how it repeats and what it does by itself. Selecting it opens it in the drawer. While it runs: where it is. -->
    <Border Classes="seq-block" Classes.selected="{Binding IsSelected}" Classes.off="{Binding !IsOn}" Margin="0,0,0,8">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Center" ToolTip.Tip="On / off" AutomationProperties.Name="Block on" />
                <Button Grid.Column="1" Classes="seq-pick" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="BlockCard">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="card-title" Text="{Binding Title}" />
                            <TextBlock Classes="meta" Text="{Binding Number, StringFormat={}#{0}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{Binding Line}" TextWrapping="Wrap" AutomationProperties.AutomationId="BlockLine" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="ghost" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up" AutomationProperties.Name="Move block up" />
                    <Button Classes="ghost" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down" AutomationProperties.Name="Move block down" />
                    <Button Classes="ghost" Content="⧉" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate" AutomationProperties.Name="Duplicate block" />
                    <Button Classes="ghost" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove" AutomationProperties.Name="Remove block" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasProgress}">
                <TextBlock Classes="value" Text="{Binding ProgressText}" VerticalAlignment="Center" AutomationProperties.AutomationId="BlockProgress" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="4" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="secondary accent" Text="{Binding ActivityText}" IsVisible="{Binding HasActivity}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <StackPanel Spacing="2" IsVisible="{Binding HasStatus}">
                <TextBlock Classes="secondary accent" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BlockStatus" />
                <TextBlock Classes="meta" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="secondary danger" Text="{Binding ProblemText}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" AutomationProperties.AutomationId="BlockProblem" />
        </StackPanel>
    </Border>
</UserControl>
