<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Session.TargetStopView"
             x:DataType="vm:WorkflowEditorViewModel">

    <!-- When imaging of the whole target stops: any of these ends every block after its exposure, and the Finish part follows. -->
    <Border Classes="panel" Padding="20,16" Margin="0,8,0,0">
        <StackPanel Spacing="8" DataContext="{Binding TargetStop}" x:DataType="vm:ConditionTogglesViewModel">
            <TextBlock Classes="eyebrow" Text="TARGET STOPS WHEN ANY" />
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="Ends the imaging of all setups after their current exposure; Finish follows." />
            <WrapPanel ItemSpacing="20" LineSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox Content="Target altitude below" IsChecked="{Binding AltitudeBelowOn}" AutomationProperties.AutomationId="TargetStopAltitude" />
                    <TextBox Width="60" Text="{Binding AltitudeBelowText}" IsEnabled="{Binding AltitudeBelowOn}" AutomationProperties.AutomationId="TargetStopAltitudeValue" />
                    <TextBlock Text="°" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox Content="Dawn" IsChecked="{Binding DawnOn}" AutomationProperties.AutomationId="TargetStopDawn" />
                    <ComboBox ItemsSource="{x:Static vm:ConditionTogglesViewModel.TwilightNames}" SelectedItem="{Binding DawnKind}" IsEnabled="{Binding DawnOn}" Width="130" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox Content="Time" IsChecked="{Binding TimeOn}" AutomationProperties.AutomationId="TargetStopTime" />
                    <TextBox Width="70" Text="{Binding TimeText}" IsEnabled="{Binding TimeOn}" AutomationProperties.AutomationId="TargetStopTimeValue" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox Content="Duration" IsChecked="{Binding DurationOn}" AutomationProperties.AutomationId="TargetStopDuration" />
                    <TextBox Width="60" Text="{Binding DurationText}" IsEnabled="{Binding DurationOn}" />
                    <TextBlock Text="h" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Classes="meta" Text="{Binding ZoneText, StringFormat={}Times are read in {0}}" />
            <TextBlock Classes="meta" Text="{Binding ExtrasText}" IsVisible="{Binding HasExtras}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>

</UserControl>
