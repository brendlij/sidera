<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:session="using:Sidera.Desktop.Views.Session"
             x:Class="Sidera.Desktop.Views.Session.SessionView"
             x:DataType="vm:SessionPageViewModel">

    <!--
        The Session page: an imaging session as a workflow. The document (its name, whether it has unsaved changes, new,
        open, save) is on the left of the header; the run (its state and its controls) is on the right, apart from it.
        Below: the workflow and the inspector of the selected step.
    -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="{StaticResource InsetPage}" RowSpacing="16" MaxWidth="1760"
          HorizontalAlignment="Stretch">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="page-title" Text="{Binding Document.DisplayName}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="SessionTitle" />
                    <ctl:StatusIndicator Kind="Warning" Text="Modified" IsVisible="{Binding Document.IsDirty}" />
                    <!-- How the session is edited: as blocks, or as the tree of every step. Opening the tree asks first; going back is offered only where it is exact. -->
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" DataContext="{Binding Editor}" x:DataType="vm:SessionEditorViewModel">
                        <Button Classes="ghost" Content="Blocks" Classes.primary="{Binding IsStructured}" Command="{Binding SwitchToStructuredCommand}"
                                AutomationProperties.AutomationId="SessionModeBlocks" AutomationProperties.Name="Blocks view" />
                        <Button Classes="ghost" Content="Tree" Classes.primary="{Binding IsTree}" Command="{Binding ShowTreeCommand}"
                                AutomationProperties.AutomationId="SessionModeTree" AutomationProperties.Name="Tree view" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="-10,0,0,0">
                    <Button Classes="ghost" Content="New" Command="{Binding Document.NewCommand}" />
                    <Button Classes="ghost" Content="Open…" Command="{Binding Document.OpenCommand}" />
                    <Button Classes="ghost" Content="Save" Command="{Binding Document.SaveCommand}" />
                    <Button Classes="ghost" Content="Save As…" Command="{Binding Document.SaveAsCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- The run: its state, and its controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <ctl:StatusIndicator Kind="{Binding Sequencer.StateKind}" Text="{Binding Sequencer.StateText}" />
                <Border Width="1" Height="24" Background="{DynamicResource SideraLine}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Run" AutomationProperties.Name="Run Sequence" Command="{Binding Sequencer.RunCommand}" />
                    <Button Content="Pause" Command="{Binding Sequencer.PauseCommand}" IsVisible="{Binding !Sequencer.IsPauseState}" />
                    <Button Content="Resume" Command="{Binding Sequencer.ResumeCommand}" IsVisible="{Binding Sequencer.IsPauseState}" />
                    <Button Classes="danger" Content="Cancel" AutomationProperties.Name="Cancel Sequence" Command="{Binding Sequencer.CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- What needs a word, near what it is about: the document, the run -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border Classes="notice-info" IsVisible="{Binding Editor.IsConfirmingTree, FallbackValue=False}" AutomationProperties.AutomationId="OpenTreeNotice">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Editor.TreeWarningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary" Content="Open the tree" Command="{Binding Editor.ShowTreeCommand}" AutomationProperties.AutomationId="ConfirmOpenTree" />
                    <Button Grid.Column="2" Content="Keep the blocks" Command="{Binding Editor.CancelShowTreeCommand}" AutomationProperties.AutomationId="CancelOpenTree" />
                </Grid>
            </Border>
            <TextBlock Classes="secondary" Text="{Binding Editor.WhyNotStructuredText}" TextWrapping="Wrap" AutomationProperties.AutomationId="WhyNotBlocks"
                       IsVisible="{Binding Editor.WhyNotStructuredText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
            <Border Classes="notice-info" IsVisible="{Binding Document.IsConfirmingDiscard}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Discard unsaved changes?" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary" Content="Discard" Command="{Binding Document.ConfirmDiscardCommand}" />
                    <Button Grid.Column="2" Content="Cancel" Command="{Binding Document.CancelDiscardCommand}" />
                </Grid>
            </Border>
            <Border Classes="notice-danger" IsVisible="{Binding Document.HasError}">
                <TextBlock Classes="danger" Text="{Binding Document.ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="notice-danger" IsVisible="{Binding Sequencer.HasError}">
                <TextBlock Classes="danger" Text="{Binding Sequencer.ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="secondary" Text="{Binding Sequencer.ReadinessHint}" TextWrapping="Wrap"
                       IsVisible="{Binding Sequencer.HasReadinessHint}" />
        </StackPanel>

        <!-- The blocks: the default editor of a session -->
        <Panel Grid.Row="2" IsVisible="{Binding Editor.IsStructured, FallbackValue=False}">
            <session:SessionEditorView DataContext="{Binding Editor}" />
        </Panel>

        <!-- The tree: every step, with Parallel, Repeat and every action -->
        <Grid Grid.Row="2" ColumnSpacing="24" IsVisible="{Binding Editor.IsTree, FallbackValue=True}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,0,12,0">

                    <ItemsControl ItemsSource="{Binding Draft.SharedProblems}" IsVisible="{Binding Draft.HasSharedProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="secondary danger" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <session:WorkflowView />
                </StackPanel>
            </ScrollViewer>

            <!-- The inspector of the selected step: there only while a step is selected, so that the workflow has the width otherwise -->
            <Border Grid.Column="1" Classes="panel" Width="380" IsVisible="{Binding Draft.SelectedStep, Converter={x:Static ObjectConverters.IsNotNull}}">
                <session:StepInspectorView DataContext="{Binding Draft}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
