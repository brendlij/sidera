<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:session="using:Sidera.Desktop.Views.Session"
             x:Class="Sidera.Desktop.Views.Session.BlockDrawerView"
             x:DataType="vm:BlockDrawerViewModel">

    <!-- A block opened: the common things first (filter, exposure, frames), then its actions, how it repeats, what it does by itself, and what ends it early. -->
    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Classes="eyebrow" Text="BLOCK" />
                <TextBox Text="{Binding NameText}" PlaceholderText="Name" AutomationProperties.AutomationId="BlockName" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="✕" Command="{Binding CloseCommand}" VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close" />
        </Grid>
        <CheckBox Content="On" IsChecked="{Binding IsOn}" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <ctl:LabeledField Label="Filter" IsVisible="{Binding HasFilterWheel}">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BlockFilter">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:FilterChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </ctl:LabeledField>
            <ctl:LabeledField Grid.Column="1" Label="Exposure (s)" IsVisible="{Binding HasExposure}">
                <TextBox Text="{Binding ExposureText}" AutomationProperties.AutomationId="BlockExposure" />
            </ctl:LabeledField>
            <ctl:LabeledField Grid.Column="2" Label="Frames">
                <TextBox Text="{Binding RepeatCountText}" IsEnabled="{Binding RepeatCountOn}" AutomationProperties.AutomationId="BlockFrames" />
            </ctl:LabeledField>
        </Grid>

        <Border Classes="divider" />
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="ACTIONS" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="+ Add action" Command="{Binding AddActionCommand}" AutomationProperties.Name="Add action to block" AutomationProperties.AutomationId="BlockAddAction" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionRowViewModel">
                        <session:ActionRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Classes="divider" />
        <StackPanel Spacing="8">
            <TextBlock Classes="eyebrow" Text="REPEAT" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="A number of times" IsChecked="{Binding RepeatCountOn}" AutomationProperties.AutomationId="RepeatCountOn" />
                <TextBox Width="70" Text="{Binding RepeatCountText}" IsEnabled="{Binding RepeatCountOn}" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="Or until any of these:" />
            <session:LimitFieldsView DataContext="{Binding Until}" />
        </StackPanel>

        <Border Classes="divider" />
        <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="AUTOMATION" />
            <TextBlock Classes="meta" Text="Done by itself at a safe point; not a step to place again and again." TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <CheckBox Content="Dither" IsChecked="{Binding DitherOn}" IsEnabled="{Binding CanDither}" AutomationProperties.AutomationId="BlockDither" />
                <TextBlock Classes="meta" Text="Needs a mount and a guider on the imaging setup." IsVisible="{Binding !CanDither}" />
                <StackPanel Spacing="6" IsVisible="{Binding DitherOn}" Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="every" VerticalAlignment="Center" />
                        <TextBox Width="60" Text="{Binding DitherEveryText}" AutomationProperties.AutomationId="BlockDitherEvery" />
                        <TextBlock Text="exposures" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <ctl:LabeledField Label="Amplitude (px)"><TextBox Text="{Binding DitherAmplitudeText}" /></ctl:LabeledField>
                        <ctl:LabeledField Grid.Column="1" Label="Settle ≤ (px)"><TextBox Text="{Binding DitherThresholdText}" /></ctl:LabeledField>
                        <ctl:LabeledField Grid.Column="2" Label="for (s)"><TextBox Text="{Binding DitherStableText}" /></ctl:LabeledField>
                        <ctl:LabeledField Grid.Column="3" Label="timeout (s)"><TextBox Text="{Binding DitherTimeoutText}" /></ctl:LabeledField>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox Content="Autofocus" IsChecked="{Binding FocusOn}" IsEnabled="{Binding CanFocus}" AutomationProperties.AutomationId="BlockFocus" />
                <TextBlock Classes="meta" Text="Needs a focuser on the imaging setup." IsVisible="{Binding !CanFocus}" />
                <StackPanel Spacing="6" IsVisible="{Binding FocusOn}" Margin="24,0,0,0">
                    <CheckBox Content="When the block starts" IsChecked="{Binding FocusAtStart}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="Every" IsChecked="{Binding FocusEveryOn}" />
                        <TextBox Width="60" Text="{Binding FocusEveryText}" IsEnabled="{Binding FocusEveryOn}" />
                        <TextBlock Text="min" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="After a filter change" IsChecked="{Binding FocusAfterFilter}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <ctl:LabeledField Label="Exposure (s)"><TextBox Text="{Binding FocusExposureText}" /></ctl:LabeledField>
                        <ctl:LabeledField Grid.Column="1" Label="Step size"><TextBox Text="{Binding FocusStepText}" /></ctl:LabeledField>
                        <ctl:LabeledField Grid.Column="2" Label="Samples"><TextBox Text="{Binding FocusSamplesText}" /></ctl:LabeledField>
                    </Grid>
                    <TextBlock Classes="meta" Text="{Binding FocusMountText}" IsVisible="{Binding HasFocusMountText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BlockFocusMount" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Classes="divider" />
        <StackPanel Spacing="8">
            <TextBlock Classes="eyebrow" Text="LIMITS" />
            <TextBlock Classes="meta" Text="This block ends early when any of these holds. An exposure that is running is finished first." TextWrapping="Wrap" />
            <session:LimitFieldsView DataContext="{Binding Limits}" />
        </StackPanel>

        <Border Classes="notice-danger" IsVisible="{Binding HasProblem}">
            <TextBlock Classes="danger" Text="{Binding ProblemText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BlockDrawerProblem" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
            <Button Classes="danger" Content="Remove" Command="{Binding RemoveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
