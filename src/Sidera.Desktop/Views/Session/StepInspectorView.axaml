<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:session="using:Sidera.Desktop.Views.Session"
             x:Class="Sidera.Desktop.Views.Session.StepInspectorView"
             x:DataType="vm:SequenceDraftViewModel">

    <UserControl.Resources>
        <!-- What is wrong with a step, under its fields -->
        <DataTemplate x:Key="ProblemLine" x:DataType="x:String">
            <TextBlock Classes="secondary danger" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
        </DataTemplate>
    </UserControl.Resources>

    <!--
        The editors of the steps. The inspector shows the one of the selected step: its title, its fields, and what is
        wrong with it. A field is a FieldRow (name, input, unit); a picker has its name above it.
    -->
    <UserControl.DataTemplates>

        <DataTemplate DataType="{x:Type vm:ExposureStepDraftViewModel}" x:DataType="vm:ExposureStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Exposure" />
                </StackPanel>
                <ctl:LabeledField Label="Camera"><ContentControl Content="{Binding Camera}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <session:AcquisitionSectionView DataContext="{Binding Acquisition}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RigExposureStepDraftViewModel}" x:DataType="vm:RigExposureStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Exposure" />
                    <TextBlock Classes="secondary" Text="Uses the camera of the rig of this track." />
                </StackPanel>
                <ctl:FieldRow Label="Exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <session:AcquisitionSectionView DataContext="{Binding Acquisition}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DelayStepDraftViewModel}" x:DataType="vm:DelayStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Delay" />
                </StackPanel>
                <ctl:FieldRow Label="Duration" Unit="s"><TextBox Text="{Binding DurationText}" /></ctl:FieldRow>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SlewStepDraftViewModel}" x:DataType="vm:SlewStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Slew" />
                </StackPanel>
                <ctl:LabeledField Label="Mount"><ContentControl Content="{Binding Mount}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Right ascension" Unit="h"><TextBox Text="{Binding RightAscensionText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Declination" Unit="°"><TextBox Text="{Binding DeclinationText}" /></ctl:FieldRow>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StartGuidingStepDraftViewModel}" x:DataType="vm:StartGuidingStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Start Guiding" />
                </StackPanel>
                <ctl:LabeledField Label="Guider"><ContentControl Content="{Binding Guider}" /></ctl:LabeledField>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StopGuidingStepDraftViewModel}" x:DataType="vm:StopGuidingStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Stop Guiding" />
                </StackPanel>
                <ctl:LabeledField Label="Guider"><ContentControl Content="{Binding Guider}" /></ctl:LabeledField>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DitherStepDraftViewModel}" x:DataType="vm:DitherStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Dither" />
                </StackPanel>
                <ctl:LabeledField Label="Guider"><ContentControl Content="{Binding Guider}" /></ctl:LabeledField>
                <ctl:LabeledField Label="Mount"><ContentControl Content="{Binding Mount}" /></ctl:LabeledField>
                <ctl:LabeledField Label="Affected camera"><ContentControl Content="{Binding Camera}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Amplitude" Unit="px"><TextBox Text="{Binding AmplitudeText}" /></ctl:FieldRow>
                <Border Classes="divider" />
                <TextBlock Classes="eyebrow" Text="SETTLE AFTER DITHER" />
                <ctl:FieldRow Label="Threshold" Unit="px"><TextBox Text="{Binding SettleThresholdText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Stable for" Unit="s"><TextBox Text="{Binding SettleStableText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Timeout" Unit="s"><TextBox Text="{Binding SettleTimeoutText}" /></ctl:FieldRow>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MoveFocuserStepDraftViewModel}" x:DataType="vm:MoveFocuserStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Move Focuser" />
                </StackPanel>
                <ctl:LabeledField Label="Focuser"><ContentControl Content="{Binding Focuser}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Position" Unit="steps"><TextBox Text="{Binding PositionText}" /></ctl:FieldRow>
                <TextBlock Classes="meta" Text="{Binding RangeLabel, StringFormat={}Range: {0} steps}" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RigMoveFocuserStepDraftViewModel}" x:DataType="vm:RigMoveFocuserStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Move Focuser" />
                    <TextBlock Classes="secondary" Text="Moves the focuser of the rig of this track." />
                </StackPanel>
                <ctl:FieldRow Label="Position" Unit="steps"><TextBox Text="{Binding PositionText}" /></ctl:FieldRow>
                <TextBlock Classes="meta" Text="{Binding Summary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChangeFilterStepDraftViewModel}" x:DataType="vm:ChangeFilterStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Change Filter" />
                </StackPanel>
                <ctl:LabeledField Label="Filter wheel"><ContentControl Content="{Binding Wheel}" /></ctl:LabeledField>
                <ctl:LabeledField Label="Filter"><ContentControl Content="{Binding Filter}" /></ctl:LabeledField>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RigChangeFilterStepDraftViewModel}" x:DataType="vm:RigChangeFilterStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Change Filter" />
                    <TextBlock Classes="secondary" Text="Turns the filter wheel of the rig of this track." />
                </StackPanel>
                <ctl:LabeledField Label="Filter"><ContentControl Content="{Binding Filter}" /></ctl:LabeledField>
                <TextBlock Classes="meta" Text="{Binding Summary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SlewAndCenterStepDraftViewModel}" x:DataType="vm:SlewAndCenterStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Slew &amp; Center" />
                </StackPanel>
                <ctl:LabeledField Label="Mount"><ContentControl Content="{Binding Mount}" /></ctl:LabeledField>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Right ascension" Unit="h"><TextBox Text="{Binding RightAscensionText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Declination" Unit="°"><TextBox Text="{Binding DeclinationText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Tolerance" Unit="arcsec"><TextBox Text="{Binding ToleranceText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Attempts"><TextBox Text="{Binding MaxAttemptsText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Solve exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <TextBlock Classes="meta" Text="{Binding FramingText}" IsVisible="{Binding FramingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="secondary" Text="Slews, solves, and corrects the slew until the target is within the tolerance. The mount is never synchronized." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RotateToAngleStepDraftViewModel}" x:DataType="vm:RotateToAngleStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Rotate to Angle" />
                </StackPanel>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Sky rotation" Unit="°"><TextBox Text="{Binding AngleText}" /></ctl:FieldRow>
                <TextBlock Classes="secondary" Text="Turns the rotator by the calibration of the rig. Does not solve and does not check the result; the mount is never synchronized." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RotateAndVerifyStepDraftViewModel}" x:DataType="vm:RotateAndVerifyStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Rotate &amp; Verify" />
                </StackPanel>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Sky rotation" Unit="°"><TextBox Text="{Binding AngleText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Tolerance" Unit="°"><TextBox Text="{Binding ToleranceText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Attempts"><TextBox Text="{Binding MaxAttemptsText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Solve exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <TextBlock Classes="secondary" Text="Rotates, solves, and corrects until the sky is at the angle within the tolerance; the solve decides. The mount is never synchronized." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CenterAndRotateStepDraftViewModel}" x:DataType="vm:CenterAndRotateStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Center &amp; Rotate" />
                </StackPanel>
                <ctl:LabeledField Label="Mount"><ContentControl Content="{Binding Mount}" /></ctl:LabeledField>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Right ascension" Unit="h"><TextBox Text="{Binding RightAscensionText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Declination" Unit="°"><TextBox Text="{Binding DeclinationText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Position tolerance" Unit="arcsec"><TextBox Text="{Binding ToleranceText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Centering attempts"><TextBox Text="{Binding MaxCenteringAttemptsText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Sky rotation" Unit="°"><TextBox Text="{Binding AngleText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Rotation tolerance" Unit="°"><TextBox Text="{Binding RotationToleranceText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Rotation attempts"><TextBox Text="{Binding MaxRotationAttemptsText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Rounds"><TextBox Text="{Binding MaxRoundsText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Solve exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <TextBlock Classes="meta" Text="{Binding FramingText}" IsVisible="{Binding FramingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="secondary" Text="Centers the target, rotates and verifies the rotation, and centers again when turning moved the field. Ends when both tolerances hold. The mount is never synchronized." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SyncMountStepDraftViewModel}" x:DataType="vm:SyncMountStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Sync Mount to Solved Position" />
                </StackPanel>
                <ctl:LabeledField Label="Mount"><ContentControl Content="{Binding Mount}" /></ctl:LabeledField>
                <Border Classes="notice-info">
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Synchronizes the mount to the most recent successful plate-solved position. Advanced: it changes what the mount believes. It does not solve; put a Plate Solve before it." />
                </Border>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlateSolveStepDraftViewModel}" x:DataType="vm:PlateSolveStepDraftViewModel">
            <StackPanel Spacing="16">
                <TextBlock Classes="section-title" Text="Plate Solve" />
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Solve exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <TextBlock Classes="secondary" Text="Captures and solves with the configured backend and solver defaults." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutofocusStepDraftViewModel}" x:DataType="vm:AutofocusStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Autofocus" />
                </StackPanel>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <ctl:FieldRow Label="Exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Step size" Unit="steps"><TextBox Text="{Binding StepSizeText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Samples"><TextBox Text="{Binding SamplesText}" /></ctl:FieldRow>
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Takes exposures with the camera of the rig at positions around the current focuser position, fits the focus curve and moves the focuser of the rig to the best one. The filter that is in place is used; nothing else moves." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RigAutofocusStepDraftViewModel}" x:DataType="vm:RigAutofocusStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Autofocus" />
                    <TextBlock Classes="secondary" Text="Focuses the rig of this track: its camera and its focuser." />
                </StackPanel>
                <ctl:FieldRow Label="Exposure" Unit="s"><TextBox Text="{Binding ExposureText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Step size" Unit="steps"><TextBox Text="{Binding StepSizeText}" /></ctl:FieldRow>
                <ctl:FieldRow Label="Samples"><TextBox Text="{Binding SamplesText}" /></ctl:FieldRow>
                <TextBlock Classes="meta" Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="The other rigs go on while this one focuses. A dither of the shared mount waits until it is done." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RepeatStepDraftViewModel}" x:DataType="vm:RepeatStepDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}STEP {0}}" />
                    <TextBlock Classes="section-title" Text="Repeat" />
                </StackPanel>
                <ctl:FieldRow Label="Repeat count" Unit="×"><TextBox Text="{Binding CountText}" /></ctl:FieldRow>
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="The steps inside run in order, once per repetition. Select the Repeat or a step inside it and use Add step, then Add to selected Repeat, to add more." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>

        <!-- The Multi-Rig block: its tracks as lanes, then the policy that coordinates them -->
        <DataTemplate DataType="{x:Type vm:MultiRigStepDraftViewModel}" x:DataType="vm:MultiRigStepDraftViewModel">
            <session:MultiRigEditorView />
        </DataTemplate>

        <!-- A Rig Track: its rig, what it does, and the autofocus policy of the rig -->
        <DataTemplate DataType="{x:Type vm:RigTrackDraftViewModel}" x:DataType="vm:RigTrackDraftViewModel">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="{Binding NumberLabel, StringFormat={}RIG TRACK {0}}" />
                    <TextBlock Classes="section-title" Text="{Binding Title}" />
                </StackPanel>
                <ctl:LabeledField Label="Rig"><ContentControl Content="{Binding Rig}" /></ctl:LabeledField>
                <TextBlock Classes="secondary" Text="{Binding Summary}" TextWrapping="Wrap" />

                <Border Classes="divider" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="card-title" Text="Autofocus policy" />
                        <TextBlock Classes="meta" Text="Focus this rig by itself" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding AutofocusEnabled}" />
                </Grid>
                <StackPanel Spacing="12" IsEnabled="{Binding AutofocusEnabled}">
                    <TextBlock Classes="meta" Text="Triggers" />
                    <CheckBox Content="At track start" IsChecked="{Binding AutofocusAtStart}" />
                    <CheckBox Content="After filter change" IsChecked="{Binding AutofocusAfterFilterChange}" />
                    <ctl:FieldRow Label="Exposure" Unit="s"><TextBox Text="{Binding AutofocusExposureText}" /></ctl:FieldRow>
                    <ctl:FieldRow Label="Step size" Unit="steps"><TextBox Text="{Binding AutofocusStepSizeText}" /></ctl:FieldRow>
                    <ctl:FieldRow Label="Samples"><TextBox Text="{Binding AutofocusSamplesText}" /></ctl:FieldRow>
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="The rig focuses by itself where the triggers say: once before the first step of this track, and after each Change Filter step. An Autofocus step you add in the place of one does that focus instead." />
                </StackPanel>
                <Border Classes="divider" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Use Add step, then Add to selected Rig Track, for what this rig does: exposures with its camera, moving its focuser, changing its filter, delays, and Repeats of those." />
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedStep, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding SelectedStep}" IsEnabled="{Binding IsEditable}" Margin="0,0,12,0" />
        </ScrollViewer>
        <ctl:EmptyState Icon="{StaticResource IconSession}" VerticalAlignment="Top" Margin="0,48,0,0"
                        IsVisible="{Binding SelectedStep, Converter={x:Static ObjectConverters.IsNull}}"
                        Title="Nothing selected"
                        Message="Select a step in the workflow to edit it here." />
    </Grid>
</UserControl>
