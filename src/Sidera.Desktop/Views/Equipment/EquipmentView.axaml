<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:equipment="using:Sidera.Desktop.Views.Equipment"
             x:Class="Sidera.Desktop.Views.Equipment.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <!--
        The equipment: a tab for each kind of device, and on each the choice of the driver with connect beside it, then the device.
        Nothing is added or removed by hand: choosing a driver (or none) is how the equipment is set up.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="{StaticResource InsetPage}" RowSpacing="16">
        <ctl:PageHeader Title="Equipment" />

        <StackPanel Grid.Row="1" Spacing="8">
            <Border Classes="notice-danger" IsVisible="{Binding HasProblems}">
                <TextBlock Classes="danger" Text="{Binding ProblemsText}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="notice-danger" IsVisible="{Binding HasNotice}">
                <TextBlock Classes="danger" Text="{Binding NoticeText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="20" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceSlotViewModel">
                    <RadioButton Classes="tab" GroupName="EquipmentSlot" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding Title}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Classes="divider" />

        <ctl:EmptyState Grid.Row="4" Icon="{StaticResource IconEquipment}" Title="Nothing selected" Margin="0,96"
                        Message="Choose a kind of device above, then pick its driver."
                        IsVisible="{Binding SelectedSlot, Converter={x:Static ObjectConverters.IsNull}}" />

        <ContentControl Grid.Row="4" Content="{Binding SelectedSlot}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:DeviceSlotViewModel">
                    <equipment:DeviceSlotView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
