<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             x:Class="Sidera.Desktop.Views.Equipment.Workspaces.DeviceHeaderView"
             x:DataType="vm:DeviceDetailViewModel">

    <!--
        What the device is doing, the same for every device: its connection, its activity, and the problems it reports. A mount also
        has a Stop that is always there. Choosing, setting up and connecting the device is the row above.
    -->
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ctl:StatusIndicator Kind="{Binding Device.StatusKind}" Text="{Binding Device.StatusText}" />
            <TextBlock Classes="secondary" Text="{Binding Device.ActivityText, StringFormat={}· {0}}" VerticalAlignment="Center"
                       IsVisible="{Binding Device.IsConnected}" />
            <Button Classes="danger" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding HasStop}"
                    AutomationProperties.Name="Stop all movement" />
        </StackPanel>

        <Border Classes="notice-danger" IsVisible="{Binding Device.HasError, FallbackValue=False}">
            <TextBlock Classes="danger" Text="{Binding Device.ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="notice-danger" IsVisible="{Binding Panel.HasError, FallbackValue=False}">
            <TextBlock Classes="danger" Text="{Binding Panel.ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="panel" IsVisible="{Binding Panel.HasNotice, FallbackValue=False}">
            <TextBlock Classes="secondary" Text="{Binding Panel.NoticeText}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
