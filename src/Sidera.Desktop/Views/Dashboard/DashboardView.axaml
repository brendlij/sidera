<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:conv="using:Sidera.Desktop.Converters"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:dash="using:Sidera.Desktop.Views.Dashboard"
             xmlns:session="using:Sidera.Desktop.Views.Session"
             x:Class="Sidera.Desktop.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:RigViewModel"><dash:RigStatusCard /></DataTemplate>
        <DataTemplate x:DataType="vm:CameraViewModel"><dash:CameraStatusCard /></DataTemplate>
        <DataTemplate x:DataType="vm:SharedStatusItem">
            <StackPanel Spacing="2" MinWidth="150">
                <TextBlock Classes="eyebrow" Text="{Binding Role}" />
                <TextBlock Classes="value" Text="{Binding Name}" TextWrapping="Wrap" />
                <ctl:StatusIndicator Kind="{Binding Kind}" Text="{Binding StatusText}"
                                     IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!--
        The dashboard: what Sidera is doing right now. The session at the top, the work or the equipment on the left,
        the latest image on the right, what the session shares below.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource InsetPage}" Spacing="24" MaxWidth="1600">

            <ctl:PageHeader Title="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Classes="value-large" Text="{Binding ElapsedText}" IsVisible="{Binding HasElapsed}"
                               AutomationProperties.AutomationId="DashboardElapsed" />
                    <ctl:StatusIndicator Kind="{Binding StateKind}" Text="{Binding StateText}" />
                </StackPanel>
            </ctl:PageHeader>

            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="24">

                <!-- Left: the imaging setups while a sequence with lanes runs, otherwise the step that runs, and the equipment -->
                <StackPanel Spacing="24" MinWidth="320">

                    <Border Classes="notice-danger" IsVisible="{Binding HasRunError}">
                        <TextBlock Classes="danger" Text="{Binding RunError}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Spacing="12" IsVisible="{Binding ShowLanes}">
                        <TextBlock Classes="eyebrow" Text="{Binding LanesTitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" AutomationProperties.AutomationId="DashboardLanesTitle" />
                        <session:ExecutionTracksView DataContext="{Binding Execution}" />
                        <TextBlock Classes="secondary accent" Text="{Binding Execution.SharedActivity}" TextWrapping="Wrap" IsVisible="{Binding Execution.HasSharedActivity}"
                                   AutomationProperties.AutomationId="DashboardSharedActivity" />
                    </StackPanel>

                    <Border Classes="panel" IsVisible="{Binding ShowActivity}">
                        <StackPanel Spacing="8" DataContext="{Binding Execution}" x:DataType="vm:ExecutionOverviewViewModel">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="eyebrow" Text="NOW RUNNING" />
                                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding StepCounterText}" />
                            </Grid>
                            <TextBlock Classes="section-title" Text="{Binding ActivityTitle}" TextWrapping="Wrap" />
                            <TextBlock Classes="secondary" Text="{Binding ActivityContext}" TextWrapping="Wrap"
                                       IsVisible="{Binding ActivityContext, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Spacing="4" IsVisible="{Binding HasActivityCamera}">
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ActivityCamera.ExposureProgress}" />
                                <TextBlock Classes="meta" Text="{Binding ActivityCamera.ActivityText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nothing runs: say so, and where a session is made -->
                    <Border Classes="panel" IsVisible="{Binding IsIdle}">
                        <Grid>
                            <ctl:EmptyState Icon="{StaticResource IconSession}" MinHeight="120" IsVisible="{Binding HasSession}"
                                            Title="{Binding IdleTitle}"
                                            Message="{Binding SessionSummary, StringFormat={}Your session has {0}. Open it to run or edit it.}">
                                <Button Content="Open Session" Command="{Binding OpenSessionCommand}" />
                            </ctl:EmptyState>
                            <ctl:EmptyState Icon="{StaticResource IconSession}" MinHeight="120" IsVisible="{Binding !HasSession}"
                                            Title="No active sequence"
                                            Message="Create or open a sequence to begin.">
                                <Button Content="Open Session" Command="{Binding OpenSessionCommand}" />
                            </ctl:EmptyState>
                        </Grid>
                    </Border>

                    <!-- The equipment, as cards of the imaging setups, and as camera cards when no setup can image -->
                    <StackPanel Spacing="12" IsVisible="{Binding ShowUnits}">
                        <TextBlock Classes="eyebrow" Text="{Binding UnitsTitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Units}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Right: the latest image, and the guide graph when the guider measures -->
                <StackPanel Grid.Column="1" Spacing="24" VerticalAlignment="Top" MinWidth="280">
                <Border Classes="panel" IsVisible="{Binding HasGuider}">
                    <StackPanel Spacing="12" DataContext="{Binding Guider}" x:DataType="vm:GuiderViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="eyebrow" Text="GUIDING" />
                            <TextBlock Grid.Column="1" Classes="meta" Text="{Binding GuidingState}" />
                        </Grid>
                        <ctl:GuideGraph Height="160" History="{Binding GraphHistory}" Version="{Binding GraphVersion}"
                                        WindowSeconds="{Binding GraphWindowSeconds}" InArcseconds="{Binding GraphInArcseconds}"
                                        AutomationProperties.Name="Guide error graph" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel><TextBlock Classes="meta" Text="RMS" /><TextBlock Classes="value" Text="{Binding RmsText}" /></StackPanel>
                            <StackPanel><TextBlock Classes="meta" Text="RA" /><TextBlock Classes="value" Text="{Binding RmsRaText}" /></StackPanel>
                            <StackPanel><TextBlock Classes="meta" Text="Dec" /><TextBlock Classes="value" Text="{Binding RmsDecText}" /></StackPanel>
                            <StackPanel><TextBlock Classes="meta" Text="SNR" /><TextBlock Classes="value" Text="{Binding SnrText}" /></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="panel">
                    <StackPanel Spacing="12" DataContext="{Binding Imaging}" x:DataType="vm:ImagingViewModel">
                        <TextBlock Classes="eyebrow" Text="LATEST IMAGE" />
                        <Border Classes="preview" MinHeight="200">
                            <Grid>
                                <Image Source="{Binding LatestFrame, Converter={x:Static conv:FrameToBitmapConverter.Instance}}" Stretch="Uniform" />
                                <ctl:EmptyState Classes="on-preview" Icon="{StaticResource IconImaging}" IsVisible="{Binding !HasFrame}" Margin="16"
                                                Title="No frame yet"
                                                Message="Capture an exposure to preview and analyze it." />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="2" IsVisible="{Binding HasFrame}">
                            <TextBlock Classes="value" Text="{Binding AnalysisSummaryText}" TextWrapping="Wrap"
                                       IsVisible="{Binding AnalysisSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="DashboardFrameSummary" />
                            <TextBlock Classes="meta" Text="{Binding SourceText}" TextWrapping="Wrap" />
                            <TextBlock Classes="meta" Text="{Binding DimensionsText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- What the session shares -->
            <StackPanel Spacing="12" IsVisible="{Binding HasShared}">
                <Border Classes="divider" />
                <TextBlock Classes="eyebrow" Text="{Binding SharedTitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" AutomationProperties.AutomationId="DashboardSharedTitle" />
                <ItemsControl ItemsSource="{Binding SharedItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="32" LineSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
