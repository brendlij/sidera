<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sidera.Desktop.ViewModels"
        xmlns:shell="using:Sidera.Desktop.Views.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Sidera.Desktop.Views.Shell.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="{DynamicResource SideraBg0}"
        Foreground="{DynamicResource SideraText}"
        FontSize="{StaticResource FontBody}"
        Title="Sidera">

    <!-- The shell: the sidebar and the page. A page is whatever view the application maps the current page model to. -->
    <Grid ColumnDefinitions="Auto,*">
        <shell:SidebarView />
        <Border Grid.Column="1" Classes="workspace" CornerRadius="12,0,0,0" ClipToBounds="True">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
