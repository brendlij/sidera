<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sidera.Desktop.ViewModels"
        xmlns:shell="using:Sidera.Desktop.Views.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Sidera.Desktop.Views.Shell.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="{DynamicResource SideraBg0}"
        Foreground="{DynamicResource SideraText}"
        FontSize="{StaticResource FontBody}"
        Title="Sidera">

    <!-- The shell: the sidebar and the page. A page is whatever view the application maps the current page model to. -->
    <Panel>
        <Grid ColumnDefinitions="Auto,*">
            <shell:SidebarView />
            <DockPanel Grid.Column="1">
                <shell:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />
                <Border Classes="workspace" CornerRadius="12,0,0,0" ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- Before real equipment moves: the question the hardware tests answer with an environment variable, here answered by the person at the telescope. -->
        <Border IsVisible="{Binding Safety.IsPending}" Background="{DynamicResource SideraScrim}" AutomationProperties.AutomationId="HardwareConfirmation">
            <Border Classes="panel" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22">
                <StackPanel Spacing="12" DataContext="{Binding Safety}" x:DataType="vm:HardwareSafetyViewModel">
                    <TextBlock Classes="eyebrow" Text="EQUIPMENT WILL MOVE" />
                    <TextBlock Classes="section-title" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="value" Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="HardwareConfirmationMessage" />
                    <TextBlock Text="{Binding SafetyText}" TextWrapping="Wrap" />
                    <TextBlock Classes="meta" Text="{Binding RememberText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="HardwareCancel" />
                        <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" AutomationProperties.AutomationId="HardwareContinue" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
