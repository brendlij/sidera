<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:conv="using:Sidera.Desktop.Converters"
             x:Class="Sidera.Desktop.Views.Shell.SidebarView"
             x:DataType="vm:MainViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:NavItemViewModel">
            <Button Classes="nav" Classes.active="{Binding IsSelected}" Command="{Binding Command}"
                    AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,Auto,*" Height="38">
                    <Border Classes="navMarker" />
                    <PathIcon Grid.Column="1" Margin="12,0,12,0" Width="18" Height="18" VerticalAlignment="Center"
                              Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}"
                              Foreground="{DynamicResource SideraMuted}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- The sidebar: the work above the line, the care of the application below it, the state of the runtime at the foot -->
    <Border Classes="sidebar" Width="200">
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,24,12,16">
            <StackPanel Margin="0,0,0,24" Spacing="16">
                <TextBlock Classes="wordmark" Text="SIDERA" Margin="14,0,0,0" />

                <!-- The imaging setup everything works with. With one there is nothing to choose: its name, quietly. With several the choice is here. -->
                <StackPanel Spacing="4" Margin="14,0,0,0" DataContext="{Binding SetupContext}" x:DataType="vm:ImagingSetupContext" IsVisible="{Binding HasCurrent}">
                    <TextBlock Classes="eyebrow" Text="IMAGING SETUP" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasSeveral}" HorizontalAlignment="Stretch" Margin="0,0,2,0"
                              AutomationProperties.AutomationId="SetupSwitcher" AutomationProperties.Name="Imaging Setup">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupOption">
                                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Detail}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="value" Text="{Binding Name}" IsVisible="{Binding HasOne}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" AutomationProperties.AutomationId="SetupName" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="2">
                <ItemsControl ItemsSource="{Binding PrimaryNavigation}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Classes="divider" Margin="8,12" />
                <ItemsControl ItemsSource="{Binding SecondaryNavigation}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="14,0,0,0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SideraOk}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Runtime.StatusText}" Classes="secondary" AutomationProperties.AutomationId="RuntimeStatus" />
                </StackPanel>
                <TextBlock Text="{Binding Runtime.ModeText}" Classes="meta" Margin="16,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
