<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Sidera.Desktop.ViewModels" xmlns:ctl="using:Sidera.Desktop.Controls"
 xmlns:rig="using:Sidera.Core.Rigs" xmlns:mount="using:Sidera.Core.Mounts"
 x:Class="Sidera.Desktop.Views.Imaging.PlateSolveView" x:DataType="vm:PlateSolveViewModel">
 <ScrollViewer><StackPanel Margin="{StaticResource InsetPage}" Spacing="16" MaxWidth="950" HorizontalAlignment="Left">
  <ctl:PageHeader Title="Plate Solve" />
  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
   <ctl:LabeledField Label="Rig"><ComboBox ItemsSource="{Binding Rigs}" SelectedItem="{Binding SelectedRig}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="rig:Rig"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox></ctl:LabeledField>
   <ctl:LabeledField Grid.Column="1" Label="Mount"><ComboBox ItemsSource="{Binding Mounts}" SelectedItem="{Binding SelectedMount}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="mount:IMount"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox></ctl:LabeledField>
   <ctl:LabeledField Grid.Column="2" Label="Exposure (s)"><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0.001" Maximum="3600" /></ctl:LabeledField>
  </Grid>
  <ctl:InfoRow Label="Camera" Value="{Binding CameraName}" />
  <ctl:InfoRow Label="Solver" Value="{Binding SolverName}" />
  <TextBlock Classes="eyebrow" Text="HINTS" />
  <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" />
  <StackPanel Orientation="Horizontal" Spacing="8">
   <Button Classes="primary" Content="Capture &amp; Solve" Command="{Binding CaptureAndSolveCommand}" IsEnabled="{Binding !IsBusy}" />
   <Button Content="Solve Last Frame" Command="{Binding SolveLastFrameCommand}" IsEnabled="{Binding !IsBusy}" />
   <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
  </StackPanel>
  <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
  <Separator />
  <TextBlock Classes="eyebrow" Text="SLEW &amp; CENTER" />
  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
   <ctl:LabeledField Label="RA (h)"><NumericUpDown Value="{Binding RaHours}" Minimum="0" Maximum="23.999999" /></ctl:LabeledField>
   <ctl:LabeledField Grid.Column="1" Label="Dec (°)"><NumericUpDown Value="{Binding DecDegrees}" Minimum="-90" Maximum="90" /></ctl:LabeledField>
   <ctl:LabeledField Grid.Column="2" Label="Tolerance (arcsec)"><NumericUpDown Value="{Binding ToleranceArcseconds}" Minimum="0.01" Maximum="3600" /></ctl:LabeledField>
   <ctl:LabeledField Grid.Column="3" Label="Max attempts"><NumericUpDown Value="{Binding MaxAttempts}" Minimum="1" Maximum="100" /></ctl:LabeledField>
  </Grid>
  <Button Content="Slew &amp; Center" Command="{Binding SlewAndCenterCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
 </StackPanel></ScrollViewer>
</UserControl>
