<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sidera.Desktop.ViewModels"
             xmlns:ctl="using:Sidera.Desktop.Controls"
             xmlns:conv="using:Sidera.Desktop.Converters"
             xmlns:sky="using:Sidera.Sky"
             x:Class="Sidera.Desktop.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!-- Settings: the groups they will live in, and what is decided today. No switch that does nothing. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource InsetPage}" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
            <ctl:PageHeader Title="Settings" />
            <Border Classes="notice-info">
                <StackPanel Spacing="4">
                    <TextBlock Classes="secondary" Text="{Binding NoteText}" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" Text="{Binding SaveNoteText}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSaveNote" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsTabViewModel">
                        <RadioButton Classes="tab" Margin="0,0,20,4" GroupName="SettingsTab" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The observing site: one place for the whole application, unknown until it is entered -->
            <StackPanel Spacing="12" IsVisible="{Binding IsObservatory}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="eyebrow" Text="OBSERVING SITE" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="Where you observe. Latitude north and longitude east are positive (or write N, S, E, W). Used by calculations that need a location; a mount is compared with it when it connects." />
                </StackPanel>
                <Border Classes="panel">
                    <StackPanel Spacing="12" DataContext="{Binding Site}" x:DataType="vm:SiteSettingsViewModel">
                        <TextBlock Classes="value" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="SiteStatus" />
                        <ctl:LabeledField Label="Name (optional)"><TextBox Text="{Binding NameText}" AutomationProperties.Name="Site name" /></ctl:LabeledField>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <ctl:LabeledField Label="Latitude"><TextBox Text="{Binding LatitudeText}" PlaceholderText="47.7192° N" AutomationProperties.Name="Site latitude" /></ctl:LabeledField>
                            <ctl:LabeledField Grid.Column="1" Label="Longitude"><TextBox Text="{Binding LongitudeText}" PlaceholderText="7.8231° E" AutomationProperties.Name="Site longitude" /></ctl:LabeledField>
                            <ctl:LabeledField Grid.Column="2" Label="Elevation"><TextBox Text="{Binding ElevationText}" PlaceholderText="410 m" AutomationProperties.Name="Site elevation" /></ctl:LabeledField>
                        </Grid>
                        <Border Classes="notice-danger" IsVisible="{Binding HasProblem}">
                            <TextBlock Classes="danger" Text="{Binding ProblemText}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="Save site" Command="{Binding SaveCommand}" AutomationProperties.Name="Save site" />
                            <Button Content="Clear" Command="{Binding ClearCommand}" AutomationProperties.Name="Clear site" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel DataContext="{Binding PlateSolving}" x:DataType="vm:PlateSolvingSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsPlateSolving}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="PLATE SOLVING" />
                <ctl:LabeledField Label="Backend"><ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" /></ctl:LabeledField>
                <ctl:LabeledField Label="ASTAP executable (empty for discovery)"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ExecutablePath}" /><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" /></Grid></ctl:LabeledField>
                <ctl:LabeledField Label="Database folder (optional)"><TextBox Text="{Binding DatabasePath}" /></ctl:LabeledField>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Timeout (s)"><NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Search radius (°)"><NumericUpDown Value="{Binding SearchRadiusDegrees}" Minimum="0.01" Maximum="180" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Downsample"><ComboBox ItemsSource="{Binding Downsamples}" SelectedItem="{Binding Downsample}" /></ctl:LabeledField>
                </Grid>
                <CheckBox Content="Allow blind fallback" IsChecked="{Binding BlindFallback}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Solve exposure (s)"><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0.001" Maximum="3600" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Centering tolerance (arcsec)"><NumericUpDown Value="{Binding ToleranceArcseconds}" Minimum="0.01" Maximum="3600" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Max attempts"><NumericUpDown Value="{Binding MaxAttempts}" Minimum="1" Maximum="100" /></ctl:LabeledField>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Rotation tolerance (°)"><NumericUpDown Value="{Binding RotationToleranceDegrees}" Minimum="0.001" Maximum="90" Increment="0.1" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Rotation attempts"><NumericUpDown Value="{Binding MaxRotationAttempts}" Minimum="1" Maximum="20" /></ctl:LabeledField>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save plate solving" Command="{Binding SaveCommand}" /><Button Content="Refresh detection" Command="{Binding RefreshCommand}" /></StackPanel>
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DataContext="{Binding SkyAtlas}" x:DataType="vm:SkyAtlasSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsFraming}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="SKY ATLAS (FRAMING)" />
                <ctl:LabeledField Label="Default survey"><ComboBox ItemsSource="{Binding Surveys}" SelectedItem="{Binding SelectedSurvey}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="sky:SkySurveyDescriptor"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox></ctl:LabeledField>
                <ctl:LabeledField Label="Cache folder (empty for the default)"><TextBox Text="{Binding CacheDirectory}" /></ctl:LabeledField>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Cache size (MB)"><NumericUpDown Value="{Binding MaxCacheMegabytes}" Minimum="16" Maximum="100000" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Network timeout (s)"><NumericUpDown Value="{Binding NetworkTimeoutSeconds}" Minimum="1" Maximum="300" /></ctl:LabeledField>
                </Grid>
                <TextBlock Classes="meta" Text="The cache holds only the sky imagery you looked at, for your own use; it belongs to its source and is never shared." TextWrapping="Wrap" />
                <Button Content="Save sky atlas" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DataContext="{Binding Imaging}" x:DataType="vm:ImagingSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsImaging}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="IMAGING" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="The manual imaging page. The acquisition defaults of a camera stay with the camera." />
                <ctl:LabeledField Label="Save folder (empty for the folder the dialog chooses)"><TextBox Text="{Binding SaveDirectoryText}" AutomationProperties.Name="Save folder" /></ctl:LabeledField>
                <CheckBox Content="Auto Stretch for new frames" IsChecked="{Binding AutoStretch}" />
                <CheckBox Content="Fit the frame to the view when a manual capture arrives" IsChecked="{Binding FitOnCapture}" />
                <ctl:LabeledField Label="Manual capture exposure (s)"><TextBox Text="{Binding ManualExposureText}" AutomationProperties.Name="Manual exposure" /></ctl:LabeledField>
                <TextBlock Classes="secondary" Text="{Binding AppliesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveImaging" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" AutomationProperties.AutomationId="DiscardImaging" />
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding DirtyText}" AutomationProperties.AutomationId="DirtyImaging" />
                </StackPanel>
                <Border Classes="notice-info" IsVisible="{Binding HasResult}"><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultImaging" /></Border>
            </StackPanel>
            <StackPanel DataContext="{Binding Autofocus}" x:DataType="vm:AutofocusSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsAutofocus}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="AUTOFOCUS" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Exposure (s)"><TextBox Text="{Binding ExposureText}" AutomationProperties.Name="Autofocus exposure" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Step size"><TextBox Text="{Binding StepSizeText}" AutomationProperties.Name="Autofocus step size" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Samples"><TextBox Text="{Binding SamplesText}" AutomationProperties.Name="Autofocus samples" /></ctl:LabeledField>
                </Grid>
                <TextBlock Classes="eyebrow" Text="POLICY FOR NEW WORKFLOWS" />
                <CheckBox Content="New imaging setups with a focuser focus by themselves" IsChecked="{Binding PolicyEnabled}" />
                <CheckBox Content="Focus at the start" IsChecked="{Binding PolicyAtStart}" />
                <ctl:LabeledField Label="Refocus every (min, 0 = off)"><TextBox Text="{Binding IntervalText}" AutomationProperties.Name="Autofocus interval" /></ctl:LabeledField>
                <CheckBox Content="Refocus after a filter change" IsChecked="{Binding PolicyAfterFilterChange}" />
                <CheckBox Content="Hold the mount still while focusing (other setups on the same mount wait)" IsChecked="{Binding HoldMountStable}" AutomationProperties.AutomationId="AutofocusHoldMount" />
                <TextBlock Classes="secondary" Text="{Binding AppliesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveAutofocus" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" AutomationProperties.AutomationId="DiscardAutofocus" />
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding DirtyText}" AutomationProperties.AutomationId="DirtyAutofocus" />
                </StackPanel>
                <Border Classes="notice-info" IsVisible="{Binding HasResult}"><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultAutofocus" /></Border>
            </StackPanel>
            <StackPanel DataContext="{Binding Guiding}" x:DataType="vm:GuidingSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsGuiding}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="GUIDING" />
                <CheckBox Content="Start guiding before imaging" IsChecked="{Binding StartBeforeImaging}" />
                <CheckBox Content="Stop guiding when the session is done" IsChecked="{Binding StopWhenDone}" />
                <CheckBox Content="Dither in new workflows" IsChecked="{Binding DitherByDefault}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Dither every N frames"><TextBox Text="{Binding EveryText}" AutomationProperties.Name="Dither every" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Dither amount (px)"><TextBox Text="{Binding AmplitudeText}" AutomationProperties.Name="Dither amount" /></ctl:LabeledField>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Settle tolerance (px)"><TextBox Text="{Binding ThresholdText}" AutomationProperties.Name="Settle tolerance" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Stable for (s)"><TextBox Text="{Binding StableText}" AutomationProperties.Name="Settle stable time" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Timeout (s)"><TextBox Text="{Binding TimeoutText}" AutomationProperties.Name="Settle timeout" /></ctl:LabeledField>
                </Grid>
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="Dithering moves the guide star in both axes; RA-only dithering is not supported." />
                <TextBlock Classes="secondary" Text="{Binding AppliesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveGuiding" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" AutomationProperties.AutomationId="DiscardGuiding" />
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding DirtyText}" AutomationProperties.AutomationId="DirtyGuiding" />
                </StackPanel>
                <Border Classes="notice-info" IsVisible="{Binding HasResult}"><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultGuiding" /></Border>
            </StackPanel>
            <StackPanel DataContext="{Binding MeridianFlip}" x:DataType="vm:MeridianFlipSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsMeridianFlip}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="MERIDIAN FLIP (APPLICATION DEFAULTS)" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="What every workflow does at the meridian unless it has settings of its own. A workflow chooses between these defaults and its own on the session page." />
                <CheckBox Content="Flip at the meridian" IsChecked="{Binding Enabled}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Hold new exposures (min before)"><TextBox Text="{Binding PauseBeforeText}" AutomationProperties.Name="Pause before" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Flip (min after)"><TextBox Text="{Binding FlipAfterText}" AutomationProperties.Name="Flip after" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Latest (min after)"><TextBox Text="{Binding LatestText}" AutomationProperties.Name="Latest flip" /></ctl:LabeledField>
                </Grid>
                <CheckBox Content="Stop guiding before the flip" IsChecked="{Binding StopGuiding}" />
                <CheckBox Content="Recenter after the flip" IsChecked="{Binding Recenter}" />
                <CheckBox Content="Verify the rotation after the flip" IsChecked="{Binding VerifyRotation}" />
                <CheckBox Content="Autofocus after the flip" IsChecked="{Binding Autofocus}" />
                <CheckBox Content="Restart guiding after the flip" IsChecked="{Binding RestartGuiding}" />
                <CheckBox Content="Dither after the flip" IsChecked="{Binding Dither}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ctl:LabeledField Label="Pause after the flip (min)"><TextBox Text="{Binding PauseAfterText}" AutomationProperties.Name="Pause after" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="1" Label="Flip attempts"><TextBox Text="{Binding AttemptsText}" AutomationProperties.Name="Flip attempts" /></ctl:LabeledField>
                    <ctl:LabeledField Grid.Column="2" Label="Centering tolerance (arcsec)"><TextBox Text="{Binding ToleranceText}" AutomationProperties.Name="Centering tolerance" /></ctl:LabeledField>
                </Grid>
                <ctl:LabeledField Label="Centering attempts"><TextBox Text="{Binding CenteringAttemptsText}" AutomationProperties.Name="Centering attempts" /></ctl:LabeledField>
                <CheckBox Content="Pause the session when the flip fails (otherwise abort it)" IsChecked="{Binding PauseOnFailure}" />
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="An exposure that is running when the flip comes due is always finished first." />
                <TextBlock Classes="secondary" Text="{Binding AppliesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveMeridianFlip" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" AutomationProperties.AutomationId="DiscardMeridianFlip" />
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding DirtyText}" AutomationProperties.AutomationId="DirtyMeridianFlip" />
                </StackPanel>
                <Border Classes="notice-info" IsVisible="{Binding HasResult}"><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultMeridianFlip" /></Border>
            </StackPanel>
            <StackPanel DataContext="{Binding Sequencer}" x:DataType="vm:SequencerSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsSequencer}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="SEQUENCER" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="How a new session opens." />
                <RadioButton GroupName="DefaultSessionMode" Content="Workflow (targets, imaging blocks and policies)" IsChecked="{Binding IsWorkflowDefault}" AutomationProperties.AutomationId="DefaultModeWorkflow" />
                <RadioButton GroupName="DefaultSessionMode" Content="Advanced (the explicit tree of steps)" IsChecked="{Binding IsAdvancedDefault}" AutomationProperties.AutomationId="DefaultModeAdvanced" />
                <TextBlock Classes="secondary" Text="{Binding AppliesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveSequencer" />
                    <Button Content="Discard" Command="{Binding DiscardCommand}" AutomationProperties.AutomationId="DiscardSequencer" />
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding DirtyText}" AutomationProperties.AutomationId="DirtySequencer" />
                </StackPanel>
                <Border Classes="notice-info" IsVisible="{Binding HasResult}"><TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultSequencer" /></Border>
            </StackPanel>
            <StackPanel DataContext="{Binding Advanced}" x:DataType="vm:AdvancedSettingsViewModel" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsAdvanced}" Spacing="12">
                <TextBlock Classes="eyebrow" Text="ADVANCED" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Technical information. Nothing here is a hardware test switch: the tests of real equipment have their own variables and are not part of the application." />
                <Border Classes="panel">
                    <StackPanel Spacing="4">
                        <ctl:InfoRow Label="Settings file" Value="{Binding SettingsFileText}" />
                        <ctl:InfoRow Label="Equipment file" Value="{Binding EquipmentFileText}" />
                        <ctl:InfoRow Label="Log folder" Value="{Binding LogFolderText}" />
                    </StackPanel>
                </Border>
                <TextBlock Classes="eyebrow" Text="ENVIRONMENT VARIABLES READ" />
                <ItemsControl ItemsSource="{Binding EnvironmentText}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="secondary" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="eyebrow" Text="HARDWARE ACKNOWLEDGEMENTS" IsVisible="{Binding HasSafety}" />
                <TextBlock Classes="secondary" Text="{Binding AnsweredText}" TextWrapping="Wrap" IsVisible="{Binding HasSafety}" AutomationProperties.AutomationId="AnsweredText" />
                <Button Content="Forget hardware acknowledgements" Command="{Binding ForgetCommand}" IsVisible="{Binding HasSafety}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ForgetAcknowledgements" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding IsGeneral}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsGroup">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="eyebrow" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                                <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Classes="panel" IsVisible="{Binding HasRows}">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingRow">
                                            <ctl:InfoRow Label="{Binding Label}" Value="{Binding Value}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
