<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:Sidera.Desktop.Themes">

    <!--
        The design tokens of Sidera: every colour, size, spacing and shape that a view uses comes from here.
        Views never carry a hex colour, a font size or a margin of their own; they pick a token or a style class.
    -->
    <Styles.Resources>
        <ResourceDictionary>

            <!--
                The colours live in the themes (Themes/*.axaml): the same keys in each, chosen by the theme variant that the application is in (Settings → Appearance). The brushes below read them
                dynamically, so one brush follows the theme without anything that uses it knowing. Dark is the default.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="avares://Sidera.Desktop/Styles/Themes/Dark.axaml" />
                <ResourceInclude x:Key="Light" Source="avares://Sidera.Desktop/Styles/Themes/Light.axaml" />
                <ResourceInclude x:Key="{x:Static themes:SideraThemeVariants.Midnight}" Source="avares://Sidera.Desktop/Styles/Themes/Midnight.axaml" />
                <ResourceInclude x:Key="{x:Static themes:SideraThemeVariants.Graphite}" Source="avares://Sidera.Desktop/Styles/Themes/Graphite.axaml" />
                <ResourceInclude x:Key="{x:Static themes:SideraThemeVariants.RedNight}" Source="avares://Sidera.Desktop/Styles/Themes/RedNight.axaml" />
            </ResourceDictionary.ThemeDictionaries>

        <SolidColorBrush x:Key="SideraBg0" Color="{DynamicResource SideraBg0Color}" />
        <SolidColorBrush x:Key="SideraBg1" Color="{DynamicResource SideraBg1Color}" />
        <SolidColorBrush x:Key="SideraBg2" Color="{DynamicResource SideraBg2Color}" />
        <SolidColorBrush x:Key="SideraBg3" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="SideraBg4" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="SideraLine" Color="{DynamicResource SideraLineColor}" />
        <SolidColorBrush x:Key="SideraLineStrong" Color="{DynamicResource SideraLineStrongColor}" />
        <SolidColorBrush x:Key="SideraPreview" Color="{DynamicResource SideraPreviewColor}" />
        <SolidColorBrush x:Key="SideraOnPreviewStrong" Color="{DynamicResource SideraOnPreviewStrongColor}" />
        <SolidColorBrush x:Key="SideraOnPreviewText" Color="{DynamicResource SideraOnPreviewTextColor}" />
        <SolidColorBrush x:Key="SideraOnPreviewLine" Color="{DynamicResource SideraOnPreviewLineColor}" />
        <SolidColorBrush x:Key="SideraScrim" Color="{DynamicResource SideraScrimColor}" />

        <SolidColorBrush x:Key="SideraText" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="SideraTextSecondary" Color="{DynamicResource SideraTextSecondaryColor}" />
        <SolidColorBrush x:Key="SideraMuted" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="SideraOnAccent" Color="{DynamicResource SideraOnAccentColor}" />

        <SolidColorBrush x:Key="SideraAccent" Color="{DynamicResource SideraAccentColor}" />
        <SolidColorBrush x:Key="SideraAccentHover" Color="{DynamicResource SideraAccentHoverColor}" />
        <SolidColorBrush x:Key="SideraAccentPressed" Color="{DynamicResource SideraAccentPressedColor}" />
        <SolidColorBrush x:Key="SideraAccentTint" Color="{DynamicResource SideraAccentTintColor}" />
        <SolidColorBrush x:Key="SideraAccentTintStrong" Color="{DynamicResource SideraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="SideraOk" Color="{DynamicResource SideraOkColor}" />
        <SolidColorBrush x:Key="SideraWarn" Color="{DynamicResource SideraWarnColor}" />
        <SolidColorBrush x:Key="SideraDanger" Color="{DynamicResource SideraDangerColor}" />
        <SolidColorBrush x:Key="SideraDangerTint" Color="{DynamicResource SideraDangerTintColor}" />
        <SolidColorBrush x:Key="SideraDangerTintHover" Color="{DynamicResource SideraDangerTintHoverColor}" />
        <SolidColorBrush x:Key="SideraDangerTintPressed" Color="{DynamicResource SideraDangerTintPressedColor}" />

        <!-- Spacing: 4 8 12 16 24 32, as numbers (for Spacing) and as thickness (for Margin and Padding) -->
        <x:Double x:Key="Space1">4</x:Double>
        <x:Double x:Key="Space2">8</x:Double>
        <x:Double x:Key="Space3">12</x:Double>
        <x:Double x:Key="Space4">16</x:Double>
        <x:Double x:Key="Space5">24</x:Double>
        <x:Double x:Key="Space6">32</x:Double>
        <Thickness x:Key="Inset1">4</Thickness>
        <Thickness x:Key="Inset2">8</Thickness>
        <Thickness x:Key="Inset3">12</Thickness>
        <Thickness x:Key="Inset4">16</Thickness>
        <Thickness x:Key="Inset5">24</Thickness>
        <Thickness x:Key="Inset6">32</Thickness>
        <Thickness x:Key="InsetRow">12,8</Thickness>
        <Thickness x:Key="InsetPanel">16</Thickness>
        <Thickness x:Key="InsetPage">32,24</Thickness>

        <!-- Shape -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusLg">10</CornerRadius>

        <!-- Type scale -->
        <x:Double x:Key="FontPageTitle">24</x:Double>
        <x:Double x:Key="FontSection">17</x:Double>
        <x:Double x:Key="FontCardTitle">14</x:Double>
        <x:Double x:Key="FontValue">14</x:Double>
        <x:Double x:Key="FontBody">13</x:Double>
        <x:Double x:Key="FontSecondary">12</x:Double>
        <x:Double x:Key="FontMeta">11</x:Double>
        <x:Double x:Key="FontValueLarge">20</x:Double>
        <x:Double x:Key="FontWordmark">17</x:Double>

        <!-- Icons: 24 x 24 outlines, drawn with the foreground of the control that shows them -->
        <StreamGeometry x:Key="IconDashboard">M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z</StreamGeometry>
        <StreamGeometry x:Key="IconSession">M3 10h11v2H3zm0-4h11v2H3zm0 8h7v2H3zm13-1v8l6-4z</StreamGeometry>
        <StreamGeometry x:Key="IconImaging">M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z</StreamGeometry>
        <StreamGeometry x:Key="IconEquipment">M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z</StreamGeometry>
        <StreamGeometry x:Key="IconDiagnostics">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconDrag">M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconMore">M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconCamera">M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="IconRig">M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z</StreamGeometry>
        <StreamGeometry x:Key="IconTarget">M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3c-.46-4.17-3.77-7.48-7.94-7.94V1h-2v2.06C6.83 3.52 3.52 6.83 3.06 11H1v2h2.06c.46 4.17 3.77 7.48 7.94 7.94V23h2v-2.06c4.17-.46 7.48-3.77 7.94-7.94H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>

        <!--
            What the Fluent theme draws its controls with, set to the palette of the theme (the accent colours come with the theme itself), so that text boxes, drop-downs, check
            boxes and progress bars follow Sidera's surfaces and its one accent without a template of our own.
        -->
        <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource SideraBg2Color}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource SideraAccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource SideraMutedColor}" />
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource SideraBg2Color}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{DynamicResource SideraAccentColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource SideraLineStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource SideraAccentTintColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource SideraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{DynamicResource SideraAccentTintStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{DynamicResource SideraTextColor}" />

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource SideraLineStrongColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource SideraAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource SideraAccentHoverColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource SideraAccentPressedColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource SideraAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource SideraAccentHoverColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource SideraAccentPressedColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource SideraOnAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource SideraOnAccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource SideraOnAccentColor}" />

        <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{DynamicResource SideraLineStrongColor}" />

        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource SideraLineStrongColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource SideraBg4Color}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource SideraBg4Color}" />

        <!-- The text of the controls, in the colour of the text of the theme (Fluent would draw it white or black) -->
        <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundIndeterminate" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="RadioButtonForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource SideraTextColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="CheckBoxForegroundIndeterminateDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource SideraMutedColor}" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource SideraBg3Color}" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource SideraLineStrongColor}" />
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
