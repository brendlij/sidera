<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Inputs: one raised surface, no border until focused. The look of the Fluent controls comes from the resources in
        Tokens.axaml; here only the sizes and the shape.
    -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.readonly">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
    </Style>

    <!-- Progress: a thin bar -->
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource SideraBg3}" />
        <Setter Property="Foreground" Value="{DynamicResource SideraAccent}" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="ProgressBar.thick">
        <Setter Property="Height" Value="6" />
    </Style>

    <!-- The segmented switch of a page (All / Rigs / Shared) -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SideraTextSecondary}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SideraBg3}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SideraAccentTint}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SideraText}" />
    </Style>

    <!-- The tabs of a detail (Overview / Controls / Settings): a quiet row of words, the open one underlined in the accent -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SideraTextSecondary}" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2"
                        BorderBrush="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SideraText}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource SideraAccent}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SideraText}" />
    </Style>

    <!-- A choice shown as a card (the themes): quiet outline, the chosen one in the accent -->
    <Style Selector="RadioButton.card">
        <Setter Property="Background" Value="{DynamicResource SideraBg2}" />
        <Setter Property="Foreground" Value="{DynamicResource SideraText}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SideraLine}" BorderThickness="2"
                        CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.card:pointerover /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource SideraLineStrong}" />
    </Style>
    <Style Selector="RadioButton.card:checked /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource SideraAccent}" />
        <Setter Property="Background" Value="{DynamicResource SideraAccentTint}" />
    </Style>
</Styles>
