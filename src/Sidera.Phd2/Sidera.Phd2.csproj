<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PHD2 as a guiding backend for Sidera: the TCP event server of PHD2 (JSON, one message per line, JSON-RPC 2.0 for requests).
    Everything of the protocol stays in this project; Core, Runtime and Desktop only see the backend-neutral guider types.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidera.Core\Sidera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sidera.Phd2.Tests" />
  </ItemGroup>

</Project>
