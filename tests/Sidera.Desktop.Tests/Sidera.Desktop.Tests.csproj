<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The capturing logger of the runtime tests, for the tests of what the desktop composes. -->
    <Compile Include="..\Sidera.Runtime.Tests\Logging\LogCapture.cs" Link="Logging\LogCapture.cs" />
    <!-- The fake ASCOM drivers of the adapter tests, for the tests of what the desktop makes of ASCOM devices. -->
    <Compile Include="..\Sidera.Ascom.Tests\Fakes.cs" Link="Ascom\Fakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sidera.Desktop\Sidera.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Sidera.Ascom\Sidera.Ascom.csproj" />
    <ProjectReference Include="..\..\src\Sidera.Runtime\Sidera.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Sidera.Core\Sidera.Core.csproj" />
  </ItemGroup>

</Project>